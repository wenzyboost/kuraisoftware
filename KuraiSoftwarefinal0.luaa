-- ║   DRAWING        ║
-- ╚══════════════════╝
local Draws = {}
local function D(type, props)
    local d = Drawing.new(type)
    for k,v in pairs(props or {}) do pcall(function() d[k]=v end) end
    table.insert(Draws, d)
    return d
end

