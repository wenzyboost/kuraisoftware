    if not S.LoopGoto or not S.TargetPlayer then return end
    local root = GetRoot()
    local tr = S.TargetPlayer.Character and S.TargetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root and tr then
        root.CFrame = tr.CFrame + Vector3.new(2,2,0)
    end
