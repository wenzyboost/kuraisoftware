do
    local p = Pages["Roles"]

    Section("Info Live", p)
    Button(p, "Détecter Rôles", "🔍", function()
        RoleModule:Invalidate()
        RoleModule:Update()
        local m = RoleModule:GetMurder()
        local s = RoleModule:GetSheriff()
        Notify("Rôles",
            "Murder: " .. (m and m.Name or "?") .. " | Sheriff: " .. (s and s.Name or "?"),
            6)
    end)

    Spacer(4, p)
    Section("Liste Joueurs", p)
    local roleList = UI.New("Frame", {
        BackgroundColor3 = T.BgItem,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, 0, 0, 160),
    }, p)
    UI.Corner(9, roleList)
    local rl = UI.List(2, roleList)
    UI.Pad(8, 8, 6, 6, roleList)

    local function RefreshList()
        for _, c in ipairs(roleList:GetChildren()) do
            if c:IsA("TextLabel") then c:Destroy() end
        end
        RoleModule:Invalidate()
        RoleModule:Update()
        for _, pl in ipairs(Players:GetPlayers()) do
            UI.New("TextLabel", {
                BackgroundTransparency = 1,
                Size       = UDim2.new(1, 0, 0, 20),
                Font       = Enum.Font.Gotham,
                Text       = pl.Name .. "  " .. RoleModule:GetLabel(pl),
                TextColor3 = RoleModule:GetColor(pl),
                TextSize   = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
            }, roleList)
        end
        roleList.Size = UDim2.new(1, 0, 0, math.max(40, rl.AbsoluteContentSize.Y + 14))
    end

    Button(p, "Refresh", "↺", RefreshList)
end

