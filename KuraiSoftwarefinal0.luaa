    MkToggle(p,"Fling Auto Sheriff","Fling le sheriff dès qu'il est vu",false,function(v) flags.autoFlingSheriff=v end)
    MkSlider(p,"Puissance Fling",1000,50000,10000,function(v) flags.flingPower=v end)
