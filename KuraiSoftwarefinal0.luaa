    Slider(p, "Smooth (x100)", 1, 40, 12, function(v)
        S.CamLockSmooth = v / 100
    end)
    Picker(p, "Silent Aim Part", {"Head","HumanoidRootPart","UpperTorso"}, "Head", function(v)
        S.SilentAimPart = v
    end)
end

