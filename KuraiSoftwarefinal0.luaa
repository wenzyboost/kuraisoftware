    {n="Combat",    ic="⚔"},
    {n="Player",    ic="🏃"},
    {n="Visuals",   ic="👁"},
    {n="Teleport",  ic="📌"},
    {n="Safety",    ic="🛡"},
    {n="Utility",   ic="🔧"},
    {n="Settings",  ic="⚙"},
}

local function SwitchTab(name)
    ActiveTab = name
    ContentTitle.Text = name
    for n, pg in pairs(Pages) do
        pg.Visible = (n == name)
    end
    for n, btn in pairs(TabBtns) do
        local active = (n == name)
        local ind = btn:FindFirstChild("Ind")
        if ind then ind.Visible = active end
        local lbl = btn:FindFirstChildOfClass("TextLabel")
        if lbl then
            lbl.TextColor3 = active and T.TextPrim or T.TextSec
            lbl.Font = active and Enum.Font.GothamBold or Enum.Font.Gotham
        end
        TW(btn, AI_FAST, {
            BackgroundColor3     = active and T.Bg4 or T.Bg2,
            BackgroundTransparency = active and 0 or 1,
        })
    end
    ContentScroll.CanvasPosition = Vector2.zero
end

for i, tab in ipairs(TABS) do
    local btn = New("TextButton", {
        Name = "Tab_"..tab.n,
        BackgroundColor3 = tab.n=="Dashboard" and T.Bg4 or T.Bg2,
        BackgroundTransparency = tab.n=="Dashboard" and 0 or 1,
        BorderSizePixel = 0,
        Size = UDim2.new(1,0,0,36),
        Text = "", LayoutOrder = i,
    }, TabScroll)
    Corner(9, btn)
    local ind = New("Frame",{Name="Ind",BackgroundColor3=T.Accent,BorderSizePixel=0,
        Position=UDim2.new(0,0,0.2,0),Size=UDim2.new(0,3,0.6,0),Visible=tab.n=="Dashboard"},btn)
    Corner(99,ind)
    New("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(12,0),Size=UDim2.new(1,-14,1,0),
        Font=tab.n=="Dashboard" and Enum.Font.GothamBold or Enum.Font.Gotham,
        Text=tab.ic.."  "..tab.n,
        TextColor3=tab.n=="Dashboard" and T.TextPrim or T.TextSec,TextSize=13,
        TextXAlignment=Enum.TextXAlignment.Left},btn)
    TabBtns[tab.n] = btn

    local page = New("Frame",{Name="Page_"..tab.n,BackgroundTransparency=0,BorderSizePixel=0,
        Size=UDim2.new(1,0,0,0),Visible=tab.n=="Dashboard"},ContentScroll)
    local pl = List(4,page)
    pl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.Size=UDim2.new(1,0,0,pl.AbsoluteContentSize.Y)
    end)
    Pages[tab.n] = page

    btn.MouseButton1Click:Connect(function() SwitchTab(tab.n) end)
    btn.MouseEnter:Connect(function()
        if ActiveTab~=tab.n then TW(btn,AI_FAST,{BackgroundTransparency=0,BackgroundColor3=T.Bg3}) end
    end)
    btn.MouseLeave:Connect(function()
        if ActiveTab~=tab.n then TW(btn,AI_FAST,{BackgroundTransparency=1}) end
    end)
end

-- ══════════════════════════════════════════════════════════
--  ESP STORE
-- ══════════════════════════════════════════════════════════
local espStore = {}
local function clearEsp(plr)
    local e = espStore[plr]; if not e then return end
    if e.hl then pcall(function() e.hl:Destroy() end) end
    if e.bb then pcall(function() e.bb:Destroy() end) end
    espStore[plr] = nil
end
local function ensureEsp(plr)
    if espStore[plr] then return espStore[plr] end
    local e = {}
    e.hl = New("Highlight", {
        FillTransparency=1, OutlineTransparency=0, Enabled=false,
        DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,
    }, EspGui)
    e.bb = New("BillboardGui", {
        Size=UDim2.fromOffset(200,40), AlwaysOnTop=true, Enabled=false,
        StudsOffsetWorldSpace=Vector3.new(0,3.2,0),
    }, EspGui)
    e.scale = New("UIScale",{Scale=1},e.bb)
    e.card  = New("Frame",{
        AnchorPoint=Vector2.new(0.5,1), Position=UDim2.fromScale(0.5,1),
        Size=UDim2.fromOffset(200,32), BackgroundColor3=T.Bg1, BackgroundTransparency=0.2,
        BorderSizePixel=0,
    },e.bb)
    Corner(10,e.card)
    New("UIGradient",{Rotation=90,Transparency=NumberSequence.new({
        NumberSequenceKeypoint.new(0,0.04),NumberSequenceKeypoint.new(1,0.28)
    })},e.card)
    e.edge = New("UIStroke",{Color=T.TextPrim,Thickness=1,Transparency=0.75,ApplyStrokeMode=Enum.ApplyStrokeMode.Border},e.card)
    e.avatar = New("ImageLabel",{
        AnchorPoint=Vector2.new(0,0.5),Position=UDim2.new(0,8,0.5,0),
        Size=UDim2.fromOffset(22,22),BackgroundColor3=T.Bg3,BackgroundTransparency=0.25,
        ScaleType=Enum.ScaleType.Fit,Image="",
    },e.card)
    Corner(6,e.avatar)
    e.name = New("TextLabel",{
        BackgroundTransparency=1,AnchorPoint=Vector2.new(0,0.5),
        Position=UDim2.new(0,36,0.5,0),Size=UDim2.new(1,-110,0,15),
        Font=Enum.Font.GothamBold,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,
        Text="",TextColor3=Color3.fromRGB(255,255,255),
    },e.card)
    e.sub = New("TextLabel",{
        BackgroundTransparency=1,AnchorPoint=Vector2.new(1,0.5),
        Position=UDim2.new(1,-10,0.5,0),Size=UDim2.fromOffset(70,14),
        Font=Enum.Font.Gotham,TextSize=11,TextXAlignment=Enum.TextXAlignment.Right,
        Text="",TextColor3=T.TextSec,
    },e.card)
    espStore[plr] = e; return e
end

local boxStore = {}
local function clearBox(plr)
    local b = boxStore[plr]; if not b then return end
    for _, l in ipairs(b) do dropDraw(l) end; boxStore[plr] = nil
end
local function ensureBox(plr)
    if boxStore[plr] then return boxStore[plr] end
    local b = {}; for i=1,4 do b[i]=newLine(1) end
    boxStore[plr]=b; return b
end

local tracerStore = {}
local function clearTracer(plr)
    local t = tracerStore[plr]; if not t then return end
    dropDraw(t); tracerStore[plr]=nil
end
local function ensureTracer(plr)
    if tracerStore[plr] then return tracerStore[plr] end
    local t = newLine(2); tracerStore[plr]=t; return t
end
local function tracerOrigin()
    local vp = Camera.ViewportSize
    local from = flags.espTracerFrom
    if from=="Top" then return Vector2.new(vp.X*0.5,0)
    elseif from=="Center" then return Vector2.new(vp.X*0.5,vp.Y*0.5)
    elseif from=="Mouse" then
        local m=UserInputService:GetMouseLocation()
        return Vector2.new(m.X,m.Y)
    end
    return Vector2.new(vp.X*0.5,vp.Y)
end

bind(Players.PlayerRemoving,function(plr) clearEsp(plr); clearBox(plr); clearTracer(plr) end)
for _, p in ipairs(KM.plrs) do if p ~= LocalPlayer then ensureEsp(p) end end
bind(Players.PlayerAdded, function(p) task.wait(0.4); if p ~= LocalPlayer then ensureEsp(p) end end)

-- ══════════════════════════════════════════════════════════
--  COINS
-- ══════════════════════════════════════════════════════════
local coinCache = {}
local coinBagFull = false

local function coinTaken(d)
    local c = d:GetAttribute("Collected"); return c==true or c=="true"
end
local function freshCoins()
    local out = {}
    local tagged = CollectionService:GetTagged("ServerCoinPart")
    if #tagged > 0 then
        for _, d in ipairs(tagged) do
            if d:IsA("BasePart") and d.Parent and not coinTaken(d) then out[#out+1]=d end
        end
        return out
    end
    for _, d in ipairs(workspace:GetDescendants()) do
        if d:IsA("BasePart") and d.Parent and not coinTaken(d) and
           (d:GetAttribute("CoinID")~=nil or d.Name=="Coin_Server") then
            out[#out+1]=d
        end
    end
    return out
end

local GameplayR = RS:WaitForChild("Remotes"):WaitForChild("Gameplay")
local CoinCollectedR = GameplayR:FindFirstChild("CoinCollected")
if CoinCollectedR then
    bind(CoinCollectedR.OnClientEvent, function(_, collected, capacity)
        if type(collected)=="number" and type(capacity)=="number" and capacity>0 and collected>=capacity then
            coinBagFull = true
            if flags.autoCoins then Notify("Auto Coins","Bag full — collecte stoppée","warning") end
        end
    end)
end
local CoinsStartedR = GameplayR:FindFirstChild("CoinsStarted")
if CoinsStartedR then bind(CoinsStartedR.OnClientEvent, function() coinBagFull=false end) end

for _, rn in ipairs({"TeleportToPart","RoundStart","RoundEndFade","LoadingMap","GameOver","VictoryScreen"}) do
    local r = GameplayR:FindFirstChild(rn)
    if r and r:IsA("RemoteEvent") then bind(r.OnClientEvent, KM.markTeleport) end
end
bind(LocalPlayer.CharacterAdded, KM.markTeleport)

-- ══════════════════════════════════════════════════════════
--  FLY
-- ══════════════════════════════════════════════════════════
local flyBV, flyBG
local lastJumpAt = -10

local function startFly()
    local ch = myChar(); local hrp = getHRP(ch); local hum = getHum(ch)
    if not (hrp and hum) then return end
    hum.PlatformStand = true; KM.wantPS = true
    flyBV = New("BodyVelocity",{MaxForce=Vector3.new(1,1,1)*9e9,P=9e4,Velocity=Vector3.zero},hrp)
    flyBG = New("BodyGyro",{MaxTorque=Vector3.new(1,1,1)*9e9,P=9e4,CFrame=hrp.CFrame},hrp)
end
local function stopFly()
    local ch = myChar(); local hum = getHum(ch)
    if hum then hum.PlatformStand=false end; KM.wantPS=false
    if flyBV then flyBV:Destroy();flyBV=nil end
    if flyBG then flyBG:Destroy();flyBG=nil end
end

-- ══════════════════════════════════════════════════════════
--  NOCLIP
-- ══════════════════════════════════════════════════════════
local charParts, charPartsFor = {}, nil
local function refreshCharParts(ch)
    charParts = {}; charPartsFor = nil
    if not ch then return end
    for _, p in ipairs(ch:GetDescendants()) do
        if p:IsA("BasePart") then charParts[#charParts+1]=p end
    end
    charPartsFor = ch
end
local function getCharParts(ch)
    if ch ~= charPartsFor then refreshCharParts(ch) end
    return charParts
end
bind(LocalPlayer.CharacterAdded, function(ch) task.defer(function() refreshCharParts(ch) end) end)
if LocalPlayer.Character then refreshCharParts(LocalPlayer.Character) end

local function uncollide(ch)
    for _, p in ipairs(getCharParts(ch)) do
        if p.Parent and p.CanCollide then p.CanCollide=false; KM.unclip[p]=true end
    end
end
function KM.recollide(hum, force)
    if (not force) and (flags.noclip or KM.wantNoclip) then return end
    for p in pairs(KM.unclip) do
        if p.Parent then p.CanCollide=true end
    end
    table.clear(KM.unclip)
    if hum then pcall(function() hum:ChangeState(Enum.HumanoidStateType.GettingUp) end) end
end

-- ══════════════════════════════════════════════════════════
--  AIM
-- ══════════════════════════════════════════════════════════
local aimFov = 120

local function aimCenter()
    local m = UserInputService:GetMouseLocation(); return Vector2.new(m.X, m.Y)
end
local function aimGui()
    local c = aimCenter(); local ins = GuiService:GetGuiInset()
    return Vector2.new(c.X-ins.X, c.Y-ins.Y)
end
local function aimRay()
    local c = aimCenter()
    return Camera:ViewportPointToRay(c.X, c.Y)
end

local function fovTarget()
    local mr = myRole()
    local center = aimCenter(); local best, bd
    for _, p in ipairs(KM.plrs) do
        if p ~= LocalPlayer and alive(p) then
            local pr = roleOf(p)
            local enemy = (mr=="Murderer") or (isGunRole(mr) and pr=="Murderer")
            if enemy or pr=="Murderer" then
                local hrp = getHRP(p.Character)
                if hrp then
                    local v, on = Camera:WorldToViewportPoint(hrp.Position)
                    if on and v.Z > 0 then
                        local d = (Vector2.new(v.X,v.Y)-center).Magnitude
                        if d <= aimFov and (not bd or d < bd) then bd,best=d,p end
                    end
                end
            end
        end
    end
    return best
end

local function crosshairPlayerPos(radius)
    local center = aimCenter(); local best, bd
    for _, p in ipairs(KM.plrs) do
        if p ~= LocalPlayer and alive(p) then
            local hrp = getHRP(p.Character)
            if hrp then
                local sp = Camera:WorldToViewportPoint(hrp.Position)
                if sp.Z > 0 then
                    local d = (Vector2.new(sp.X,sp.Y)-center).Magnitude
                    if d <= radius and (not bd or d < bd) then bd=d; best=p end
                end
            end
        end
    end
    return best and (function()
        local h = best.Character:FindFirstChild("HumanoidRootPart")
        local part = best.Character:FindFirstChild("UpperTorso") or best.Character:FindFirstChild("Torso") or h
        return part and part.Position
    end)() or nil
end

