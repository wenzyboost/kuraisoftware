-- [[ AR-AI UNIVERSAL CHEAT v2.0 — Medium Fixed ]]

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local Camera           = workspace.CurrentCamera
local LocalPlayer      = Players.LocalPlayer

local Config = {
    ESP       = { Enabled = true,  BoxColor = Color3.fromRGB(255,50,50), NameColor = Color3.fromRGB(255,255,255), TracerColor = Color3.fromRGB(255,80,0), MaxDistance = 1000 },
    Aimbot    = { Enabled = true,  FOV = 180, SmoothFactor = 0.08, Prediction = true },
    SilentAim = { Enabled = true,  Hitpart = "Head" },
    KillAll   = { Enabled = false },
    WallShoot = { Enabled = true },
}

-- ══ UTILS ══
local function getChar(p)   return p.Character end
local function getRoot(p)   local c=getChar(p) return c and c:FindFirstChild("HumanoidRootPart") end
local function getHead(p)   local c=getChar(p) return c and c:FindFirstChild("Head") end
local function getHum(p)    local c=getChar(p) return c and c:FindFirstChildOfClass("Humanoid") end
local function isAlive(p)   local h=getHum(p)  return h and h.Health > 0 end
local function toScreen(pos)
    local s, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(s.X, s.Y), on
end
local function closest()
    local best, bestD = nil, Config.Aimbot.FOV
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isAlive(p) then
            local h = getHead(p)
            if h then
                local sp, on = toScreen(h.Position)
                if on then
                    local d = (center - sp).Magnitude
                    if d < bestD then bestD=d; best=p end
                end
            end
        end
    end
    return best
end

-- ══ ESP ══
local ESPObj = {}
local function makeESP(p)
    local box       = Drawing.new("Square")
    box.Visible     = false; box.Color = Config.ESP.BoxColor
    box.Thickness   = 1.5;   box.Filled = false; box.Transparency = 1

    local name      = Drawing.new("Text")
    name.Visible    = false; name.Color = Config.ESP.NameColor
    name.Size       = 14;    name.Center = true
    name.Outline    = true;  name.OutlineColor = Color3.fromRGB(0,0,0)

    local tracer    = Drawing.new("Line")
    tracer.Visible  = false; tracer.Color = Config.ESP.TracerColor; tracer.Thickness = 1

    ESPObj[p] = {box=box, name=name, tracer=tracer}
end
local function killESP(p)
    if ESPObj[p] then
        for _, o in pairs(ESPObj[p]) do pcall(function() o:Remove() end) end
        ESPObj[p] = nil
    end
end
local function updateESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not ESPObj[p] then makeESP(p) end
        local o = ESPObj[p]
        if not Config.ESP.Enabled or not isAlive(p) then
            o.box.Visible=false; o.name.Visible=false; o.tracer.Visible=false; continue
        end
        local root, head = getRoot(p), getHead(p)
        if not root or not head then continue end
        local dist = (Camera.CFrame.Position - root.Position).Magnitude
        if dist > Config.ESP.MaxDistance then
            o.box.Visible=false; o.name.Visible=false; o.tracer.Visible=false; continue
        end
        local top, topOn    = toScreen(head.Position + Vector3.new(0,1.2,0))
        local bot, botOn    = toScreen(root.Position - Vector3.new(0,3.2,0))
        if topOn and botOn then
            local h = math.abs(bot.Y - top.Y)
            local w = h * 0.45
            o.box.Visible=true; o.box.Size=Vector2.new(w,h); o.box.Position=Vector2.new(top.X-w/2, top.Y)
            o.name.Visible=true; o.name.Text=p.Name.." ["..math.floor(dist).."m]"; o.name.Position=Vector2.new(top.X, top.Y-16)
            local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
            o.tracer.Visible=true; o.tracer.From=center; o.tracer.To=Vector2.new(bot.X,bot.Y)
        else
            o.box.Visible=false; o.name.Visible=false; o.tracer.Visible=false
        end
    end
end
Players.PlayerRemoving:Connect(killESP)

-- ══ AIMBOT ══
RunService.RenderStepped:Connect(function()
    updateESP()
    if not Config.Aimbot.Enabled then return end
    local t = closest()
    if not t then return end
    local h = getHead(t)
    if not h then return end
    local pos = h.Position
    if Config.Aimbot.Prediction then
        local vel = h.AssemblyLinearVelocity or Vector3.zero
        pos = pos + vel * 0.07
    end
    Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position, pos), Config.Aimbot.SmoothFactor)
end)

-- ══ SILENT AIM — VERSION FIXÉE (pas de flood) ══
-- Au lieu du __newindex global (qui intercepte tout Roblox),
-- on hook directement la fonction FireServer des outils
if Config.SilentAim.Enabled then
    local mt = getrawmetatable(game)
    setreadonly(mt, false)
    local old_namecall = mt.__namecall
    mt.__namecall = function(self, ...)
        local method = getnamecallmethod()
        -- On intercepte seulement FireServer sur RemoteEvent (tir)
        if method == "FireServer" and self:IsA("RemoteEvent") then
            local t = closest()
            if t then
                local hp = getHead(t)
                if hp then
                    local args = {...}
                    -- Remplace le CFrame/position du tir par la tête de la cible
                    for i, v in ipairs(args) do
                        if typeof(v) == "CFrame" then
                            args[i] = CFrame.new(hp.Position)
                        elseif typeof(v) == "Vector3" then
                            args[i] = hp.Position
                        end
                    end
                    return old_namecall(self, table.unpack(args))
                end
            end
        end
        return old_namecall(self, ...)
    end
    setreadonly(mt, true)
end

-- ══ WALL SHOOT ══
if Config.WallShoot.Enabled then
    local function disableCollide(char)
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") then p.CanCollide = false end
        end
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then disableCollide(p.Character) end
        p.CharacterAdded:Connect(disableCollide)
    end
    Players.PlayerAdded:Connect(function(p)
        p.CharacterAdded:Connect(disableCollide)
    end)
end

-- ══ KILL ALL ══
local function killAll()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and isAlive(p) then
            local h = getHum(p)
            if h then
                pcall(function() h.Health = 0 end)
                pcall(function()
                    local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                    if tool and tool:FindFirstChild("Handle") then
                        local re = tool:FindFirstChildOfClass("RemoteEvent")
                        if re then re:FireServer(h, tool.Handle.CFrame) end
                    end
                end)
            end
        end
    end
end

-- ══ GUI ANIMÉ ══
local SG = Instance.new("ScreenGui")
SG.Name="AR_Menu"; SG.ResetOnSpawn=false; SG.ZIndexBehavior=Enum.ZIndexBehavior.Sibling; SG.Parent=game.CoreGui

local MF = Instance.new("Frame")
MF.Size=UDim2.new(0,320,0,390); MF.Position=UDim2.new(0.5,-160,-1,0)
MF.BackgroundColor3=Color3.fromRGB(10,10,18); MF.BorderSizePixel=0; MF.Parent=SG
Instance.new("UICorner",MF).CornerRadius=UDim.new(0,12)

local stroke=Instance.new("UIStroke",MF); stroke.Color=Color3.fromRGB(180,0,255); stroke.Thickness=2
task.spawn(function()
    local t=0
    while task.wait(0.03) do
        t=t+0.05
        stroke.Color=Color3.fromRGB(math.abs(math.sin(t))*255, 0, math.abs(math.cos(t))*255)
    end
end)

local Title=Instance.new("TextLabel")
Title.Size=UDim2.new(1,0,0,40); Title.BackgroundColor3=Color3.fromRGB(20,0,40)
Title.TextColor3=Color3.fromRGB(220,100,255); Title.Font=Enum.Font.GothamBold
Title.TextSize=16; Title.Text="⚡ AR-AI CHEAT v2.0 ⚡"; Title.Parent=MF
Instance.new("UICorner",Title).CornerRadius=UDim.new(0,10)

-- Drag
local drag,ds,sp=false,nil,nil
Title.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true;ds=i.Position;sp=MF.Position end
end)
UserInputService.InputChanged:Connect(function(i)
    if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
        local d=i.Position-ds
        MF.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
end)

local List=Instance.new("UIListLayout"); List.SortOrder=Enum.SortOrder.LayoutOrder; List.Padding=UDim.new(0,6); List.Parent=MF
local Pad=Instance.new("UIPadding",MF)
Pad.PaddingTop=UDim.new(0,48); Pad.PaddingLeft=UDim.new(0,10); Pad.PaddingRight=UDim.new(0,10); Pad.PaddingBottom=UDim.new(0,10)

local function toggle(label, cfg, key)
    local b=Instance.new("TextButton")
    b.Size=UDim2.new(1,0,0,38)
    b.BackgroundColor3=cfg[key] and Color3.fromRGB(60,0,100) or Color3.fromRGB(25,25,35)
    b.TextColor3=Color3.fromRGB(255,255,255); b.Font=Enum.Font.Gotham; b.TextSize=14
    b.Text=(cfg[key] and "✅ " or "❌ ")..label; b.AutoButtonColor=false
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,8); b.Parent=MF
    b.MouseButton1Click:Connect(function()
        cfg[key]=not cfg[key]
        b.Text=(cfg[key] and "✅ " or "❌ ")..label
        b.BackgroundColor3=cfg[key] and Color3.fromRGB(60,0,100) or Color3.fromRGB(25,25,35)
        local tw=TweenService:Create(b,TweenInfo.new(0.15,Enum.EasingStyle.Bounce),{BackgroundTransparency=0.4})
        tw:Play(); tw.Completed:Connect(function() TweenService:Create(b,TweenInfo.new(0.1),{BackgroundTransparency=0}):Play() end)
    end)
end

toggle("ESP",          Config.ESP,       "Enabled")
toggle("Aimbot",       Config.Aimbot,    "Enabled")
toggle("Silent Aim",   Config.SilentAim, "Enabled")
toggle("Wall Shoot",   Config.WallShoot, "Enabled")
toggle("Kill All",     Config.KillAll,   "Enabled")

local kb=Instance.new("TextButton")
kb.Size=UDim2.new(1,0,0,42); kb.BackgroundColor3=Color3.fromRGB(180,0,0)
kb.TextColor3=Color3.fromRGB(255,255,255); kb.Font=Enum.Font.GothamBold
kb.TextSize=15; kb.Text="💀 EXECUTE KILL ALL 💀"; kb.AutoButtonColor=false
Instance.new("UICorner",kb).CornerRadius=UDim.new(0,8); kb.Parent=MF

kb.MouseButton1Click:Connect(function()
    local root=LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then
        for i=1,8 do
            task.wait(0.05)
            local pt=Instance.new("Part")
            pt.Size=Vector3.new(0.2,0.2,0.2); pt.Anchored=true; pt.CanCollide=false
            pt.Material=Enum.Material.Neon; pt.Color=Color3.fromRGB(255,math.random(0,80),0)
            pt.CFrame=root.CFrame*CFrame.new(math.random(-5,5),0,math.random(-5,5)); pt.Parent=workspace
            TweenService:Create(pt,TweenInfo.new(0.4,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),{Size=Vector3.new(3,0.1,3),Transparency=1}):Play()
            game:GetService("Debris"):AddItem(pt,0.5)
        end
    end
    killAll()
    TweenService:Create(kb,TweenInfo.new(0.1),{BackgroundColor3=Color3.fromRGB(255,80,0)}):Play()
    task.wait(0.2)
    TweenService:Create(kb,TweenInfo.new(0.2),{BackgroundColor3=Color3.fromRGB(180,0,0)}):Play()
end)

UserInputService.InputBegan:Connect(function(i,gpe)
    if not gpe and i.KeyCode==Enum.KeyCode.RightShift then MF.Visible=not MF.Visible end
end)

-- Entrance anim
TweenService:Create(MF,TweenInfo.new(0.6,Enum.EasingStyle.Back,Enum.EasingDirection.Out),{Position=UDim2.new(0.5,-160,0.5,-195)}):Play()
print("[AR-AI v2.0] loaded. RightShift = menu.")
