TweenService:Create(MF,
    TweenInfo.new(0.65, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
    {Position = UDim2.new(0.5, -165, 0.5, -210)}
):Play()

print("[AR-AI v3.0] loaded — CTRL toggle menu")
