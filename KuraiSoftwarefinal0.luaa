-- ══════════════════════════════════════════════════════════
--  RENDER LOOP
-- ══════════════════════════════════════════════════════════
bind(RunService.RenderStepped, function()
    if isDead() then return end
    local vp     = Camera.ViewportSize
    local cx, cy = vp.X/2, vp.Y/2
    local center = Vector2.new(cx, cy)

    -- FOV
    FovCircle.Visible = flags.showFov and (flags.aimbot or flags.silentAim)
    if FovCircle.Visible then
        local mp = aimGui()
        FovCircle.Position = UDim2.fromOffset(mp.X - aimFov, mp.Y - aimFov)
        FovCircle.Size     = UDim2.fromOffset(aimFov*2, aimFov*2)
    end

    -- Aimbot
    if flags.aimbot then
        local t = fovTarget()
        if t and t.Character then
            local part = t.Character:FindFirstChild("Head") or getHRP(t.Character)
            if part then Camera.CFrame = Camera.CFrame:Lerp(CFrame.new(Camera.CFrame.Position,part.Position),0.45) end
        end
    end

    -- ESP Loop
    local myRoot2 = myRoot()
    for _, plr in ipairs(KM.plrs) do
        if plr == LocalPlayer then continue end
        local ch, _, hrp = KM.hasBody(plr)
        local anyEsp = flags.espNames or flags.espChams or flags.espBox or flags.espTracers

        if anyEsp and ch and hrp then
            local role2 = KM.espRole(plr)
            local col2  = roleColor(role2)

            -- Chams
            local e = ensureEsp(plr)
            if flags.espChams then
                e.hl.Adornee = ch; e.hl.Enabled = true
                e.hl.OutlineColor = col2
                e.hl.FillColor    = col2
                e.hl.FillTransparency = flags.espFill and 0.55 or 1
            else e.hl.Enabled = false end

            -- Nametag
            local dist = myRoot2 and math.floor((hrp.Position-myRoot2.Position).Magnitude) or 0
            local inRange = flags.espMaxDist<=0 or dist<=flags.espMaxDist
            if flags.espNames and inRange then
                e.bb.Enabled = true; e.bb.Adornee = ch:FindFirstChild("Head") or hrp
                local nm = flags.espRoleTags and (roleLabel(role2).."  "..plr.Name) or plr.Name
                if e._nm ~= nm then e._nm=nm; e.name.Text=nm end
                local sub = dist.."m"
                if e._sub ~= sub then e._sub=sub; e.sub.Text=sub end
                if e._col ~= col2 then e._col=col2; e.name.TextColor3=col2; e.edge.Color=col2 end
                -- Avatar
                if flags.espAvatar and e.avatar.Image=="" and os.clock()-(e._avAt or -99)>4 then
                    e._avAt = os.clock()
                    local uid = plr.UserId
                    task.spawn(function()
                        local ok, url = pcall(function()
                            return Players:GetUserThumbnailAsync(uid,
                                Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
                        end)
                        if ok and url and e.avatar.Parent then e.avatar.Image=url end
                    end)
                end
                e.avatar.Visible = flags.espAvatar
            else e.bb.Enabled=false end

            -- Box 2D
            if flags.espBox then
                local bx=ensureBox(plr)
                local topSP = Camera:WorldToViewportPoint(hrp.Position+Vector3.new(0,3.2,0))
                local botSP = Camera:WorldToViewportPoint(hrp.Position+Vector3.new(0,-3.2,0))
                if topSP.Z>0 and botSP.Z>0 then
                    local h2=math.abs(botSP.Y-topSP.Y); local w2=h2*0.55
                    local midX=(topSP.X+botSP.X)/2
                    local x1=midX-w2/2; local y1=topSP.Y; local x2=midX+w2/2; local y2=botSP.Y
                    local segs={{Vector2.new(x1,y1),Vector2.new(x2,y1)},{Vector2.new(x2,y1),Vector2.new(x2,y2)},
                                {Vector2.new(x2,y2),Vector2.new(x1,y2)},{Vector2.new(x1,y2),Vector2.new(x1,y1)}}
                    for i=1,4 do
                        bx[i].From=segs[i][1]; bx[i].To=segs[i][2]; bx[i].Color=col2; bx[i].Visible=true
                    end
                else for _,l in ipairs(bx) do l.Visible=false end end
            else clearBox(plr) end

            -- Tracer
            if flags.espTracers and inRange then
                local tr2=ensureTracer(plr)
                local sp=Camera:WorldToViewportPoint(hrp.Position)
                if sp.Z>0 then
                    tr2.From=tracerOrigin(); tr2.To=Vector2.new(sp.X,sp.Y)
                    tr2.Color=col2; tr2.Visible=true
                else tr2.Visible=false end
            else clearTracer(plr) end
        else
            if espStore[plr] then espStore[plr].bb.Enabled=false; espStore[plr].hl.Enabled=false end
            clearBox(plr); clearTracer(plr)
        end
    end
end)

-- ══════════════════════════════════════════════════════════
--  HEARTBEAT SYSTEMS
-- ══════════════════════════════════════════════════════════
local th = {fly=0, coins=0, fling=0, noclip=0, stats=0}

bind(RunService.Heartbeat, function(dt)
    if isDead() then return end

    -- Fly
    if flags.fly and flyBV then
        local hrp=myRoot()
        if hrp then
            local dir=Vector3.zero; local look=Camera.CFrame.LookVector; local right=Camera.CFrame.RightVector
            if UIS:IsKeyDown(Enum.KeyCode.W) then dir=dir+look end
            if UIS:IsKeyDown(Enum.KeyCode.S) then dir=dir-look end
            if UIS:IsKeyDown(Enum.KeyCode.D) then dir=dir+right end
            if UIS:IsKeyDown(Enum.KeyCode.A) then dir=dir-right end
            if UIS:IsKeyDown(Enum.KeyCode.Space) then dir=dir+Vector3.new(0,1,0) end
            if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then dir=dir-Vector3.new(0,1,0) end
            if os.clock()-lastJumpAt<0.25 then dir=dir+Vector3.new(0,1,0) end
            flyBV.Velocity=(dir.Magnitude>0 and dir.Unit or Vector3.zero)*flags.flySpeed
            flyBG.CFrame=Camera.CFrame
        end
    elseif not flags.fly and flyBV then
        stopFly()
    end

    -- Walk/Jump maintain
    local hum2 = myHum()
    if hum2 then
        if flags.walkSpeedOn then hum2.WalkSpeed = flags.walkSpeed end
        if flags.jumpPowerOn  then hum2.UseJumpPower=true; hum2.JumpPower=flags.jumpPower end
    end

    -- Noclip
    th.noclip = th.noclip + dt
    if th.noclip >= 0.05 then
        th.noclip = 0
        if flags.noclip then uncollide(myChar() or Instance.new("Folder")) end
    end

    -- Auto coins
    th.coins = th.coins + dt
    if th.coins >= 0.12 then
        th.coins = 0
        if flags.autoCoins and not coinBagFull and alive(LocalPlayer) and not KM.teleporting() then
            coinCache = freshCoins()
            local root = myRoot()
            if root then
                local best, bd
                for _, c in ipairs(coinCache) do
                    if c.Parent and not coinTaken(c) then
                        local d=(c.Position-root.Position).Magnitude
                        if d<=KM.COIN_MAX_DIST and (not bd or d<bd) then bd,best=d,c end
                    end
                end
                if best then
                    uncollide(myChar())
                    KM.markSelfTP()
                    root.CFrame = CFrame.new(best.Position+Vector3.new(0,2,0))
                    if typeof(firetouchinterest)=="function" then
                        pcall(function() firetouchinterest(root,best,0); firetouchinterest(root,best,1) end)
                    end
                end
            end
        end
    end

    -- Auto fling murderer/sheriff
    th.fling = th.fling + dt
    if th.fling >= 0.5 then
        th.fling = 0
        if (flags.autoFlingMurd or flags.autoFlingSheriff) and KM.hasBody(LocalPlayer) then
            for _, pl in ipairs(KM.plrs) do
                if pl~=LocalPlayer and alive(pl) then
                    local role3 = roleOf(pl)
                    local want = (flags.autoFlingMurd and role3=="Murderer") or
                                 (flags.autoFlingSheriff and isGunRole(role3))
                    if want then
                        local hr = getHRP(pl.Character)
                        local myhr = myRoot()
                        if hr and myhr then
                            local bv = Instance.new("BodyVelocity")
                            bv.Velocity = Vector3.new(
                                math.random(-100,100), flags.flingPower, math.random(-100,100))
                            bv.MaxForce = Vector3.new(1e9,1e9,1e9)
                            bv.Parent = hr; Debris:AddItem(bv,0.2)
                        end
                    end
                end
            end
        end
    end

    -- Murderer notify
    if flags.murdNotify then
        local myhrp = myRoot()
        local m = findMurderer()
        local mhrp = m and m~=LocalPlayer and alive(m) and getHRP(m.Character)
        if myhrp and mhrp and (mhrp.Position-myhrp.Position).Magnitude < 50 then
            if not KM._murdAlerted then
                KM._murdAlerted = true
                Notify("⚠ Murderer Proche",
                    (m.DisplayName or m.Name).."  ·  "..
                    math.floor((mhrp.Position-myhrp.Position).Magnitude).."m",
                    "error",4)
                task.delay(6, function() KM._murdAlerted=nil end)
            end
        end
    end

    -- Anti AFK
    if flags.antiAfk then
        local VU; pcall(function() VU=game:GetService("VirtualUser") end)
        if VU then pcall(function() VU:CaptureController(); VU:ClickButton2(Vector2.new()) end) end
    end
end)

bind(UserInputService.JumpRequest, function()
    lastJumpAt = os.clock()
    if flags.infJump then
        local hum3 = myHum()
        if hum3 then hum3:ChangeState(Enum.HumanoidStateType.Jumping) end
    end
end)

-- Coin ESP
task.spawn(function()
    while not isDead() do
        if flags.coinEsp then
            coinCache = freshCoins()
            -- Highlight coins (réutilise instances)
            if not KM._coinHls then KM._coinHls = {} end
            local seen = {}
            for _, c in ipairs(coinCache) do
                seen[c] = true
                if not KM._coinHls[c] then
                    KM._coinHls[c] = New("Highlight",{
                        Adornee=c,FillColor=Color3.fromRGB(255,210,55),FillTransparency=0.25,
                        OutlineColor=Color3.fromRGB(255,240,160),OutlineTransparency=0,
                        DepthMode=Enum.HighlightDepthMode.AlwaysOnTop,
                    },EspGui)
                end
            end
            for coin, hl in pairs(KM._coinHls) do
                if not seen[coin] or not coin.Parent then
                    pcall(function() hl:Destroy() end); KM._coinHls[coin]=nil
                end
            end
            task.wait(0.2)
        else
            if KM._coinHls then
                for _, hl in pairs(KM._coinHls) do pcall(function() hl:Destroy() end) end
                KM._coinHls = nil
            end
            task.wait(1)
        end
    end
end)

-- ══════════════════════════════════════════════════════════
--  RESPAWN
-- ══════════════════════════════════════════════════════════
local function OnChar(char)
    task.wait(0.7)
    local hum4 = getHum(char); if not hum4 then return end
    if flags.walkSpeedOn then hum4.WalkSpeed = flags.walkSpeed end
    if flags.jumpPowerOn then hum4.UseJumpPower=true; hum4.JumpPower=flags.jumpPower end
    if flags.fly then task.delay(0.5, function() startFly() end) end
    refreshCharParts(char)
    for _, pp in ipairs(KM.plrs) do
        if pp~=LocalPlayer and not espStore[pp] then ensureEsp(pp) end
    end
    table.clear(roleCache); table.clear(aliveCache)
end
bind(LocalPlayer.CharacterAdded, OnChar)
if LocalPlayer.Character then task.spawn(OnChar, LocalPlayer.Character) end

-- ══════════════════════════════════════════════════════════
--  KEYBIND MENU
-- ══════════════════════════════════════════════════════════
KM.menuKey = Enum.KeyCode.RightShift
bind(UserInputService.InputBegan, function(inp, gp)
    if gp or isDead() then return end
    if inp.KeyCode == KM.menuKey then
        MenuOpen = not MenuOpen
        Win.Visible = MenuOpen
        if MenuOpen then
            Win.Size = UDim2.fromOffset(WIN_W,0)
            TW(Win, AI_SPRING, {Size=UDim2.fromOffset(WIN_W,WIN_H)})
        end
    end
end)

-- Bouton "K" quand fermé
local OpenBtn = New("TextButton",{
    Name="KM_OpenBtn",BackgroundColor3=T.Accent,BorderSizePixel=0,
    Position=UDim2.fromOffset(8,200),Size=UDim2.fromOffset(36,36),
    Font=Enum.Font.GothamBlack,Text="K",TextColor3=T.TextPrim,TextSize=17,
    Visible=false,AutoButtonColor=false,
},SG)
Corner(99,OpenBtn)
Stroke(T.Accent,1.5,OpenBtn)
Win:GetPropertyChangedSignal("Visible"):Connect(function() OpenBtn.Visible=not Win.Visible end)
OpenBtn.MouseEnter:Connect(function() TW(OpenBtn,AI_FAST,{BackgroundColor3=T.AccentGlow}) end)
OpenBtn.MouseLeave:Connect(function() TW(OpenBtn,AI_FAST,{BackgroundColor3=T.Accent}) end)
OpenBtn.MouseButton1Click:Connect(function()
    MenuOpen=true; Win.Visible=true
    Win.Size=UDim2.fromOffset(WIN_W,0)
    TW(Win,AI_SPRING,{Size=UDim2.fromOffset(WIN_W,WIN_H)})
end)

-- ══════════════════════════════════════════════════════════
--  GENV UNLOAD
-- ══════════════════════════════════════════════════════════
if GENV then
    GENV.KURAIMOKA_Unload = function()
        if Unloaded then return end
        Unloaded = true
        stopFly()
        clearDrawn()
        KM.recollide(myHum(), true)
        for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
        table.clear(conns)
        pcall(function() SG:Destroy() end)
        pcall(function() EspGui:Destroy() end)
        GENV.KURAIMOKA_Unload = nil
    end
end

-- ══════════════════════════════════════════════════════════
--  STARTUP ANIMATION + NOTIF
-- ══════════════════════════════════════════════════════════
Win.Size               = UDim2.fromOffset(WIN_W,0)
Win.BackgroundTransparency = 1
task.spawn(function()
    TW(Win, AI_SPRING, {Size=UDim2.fromOffset(WIN_W,WIN_H), BackgroundTransparency=0})
end)
task.wait(1.1)
Notify("KuraiMoka chargé ✓",
    "RightShift pour toggle | discord.gg/kuraishop",
    "success", 5)

-- ══════════════════════════════════════════════════════════
--  FIN KURAIMOKA v1.0
-- ══════════════════════════════════════════════════════════
