local MM2_UNIVERSE = 66654135
if game.GameId ~= MM2_UNIVERSE then
    -- Popup d'erreur propre
    local mount = game:GetService("CoreGui")
    local sg = Instance.new("ScreenGui")
    sg.Name = "KuraiMokaWrongGame"
    sg.ResetOnSpawn = false
    sg.IgnoreGuiInset = true
    sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    sg.DisplayOrder = 999
    pcall(function() sg.Parent = mount end)
    if not sg.Parent then sg.Parent = LocalPlayer:WaitForChild("PlayerGui") end

    local shade = Instance.new("Frame")
    shade.BackgroundColor3 = Color3.fromRGB(0,0,0)
    shade.BackgroundTransparency = 1
    shade.Size = UDim2.fromScale(1,1)
    shade.BorderSizePixel = 0
    shade.Parent = sg

    local card = Instance.new("Frame")
    card.AnchorPoint = Vector2.new(0.5,0.5)
    card.Position = UDim2.fromScale(0.5,0.5)
    card.Size = UDim2.fromOffset(360,140)
    card.BackgroundColor3 = Color3.fromRGB(14,14,20)
    card.BackgroundTransparency = 1
    card.BorderSizePixel = 0
    card.Parent = sg
    local cc = Instance.new("UICorner"); cc.CornerRadius = UDim.new(0,14); cc.Parent = card
    local cs = Instance.new("UIStroke"); cs.Color = Color3.fromRGB(190,28,48); cs.Thickness = 1.5
    cs.Transparency = 1; cs.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; cs.Parent = card

    local tl = Instance.new("TextLabel")
    tl.BackgroundTransparency = 1
    tl.Position = UDim2.fromOffset(22,22)
    tl.Size = UDim2.fromOffset(316,24)
    tl.Font = Enum.Font.GothamBold
    tl.Text = "KuraiMoka — Mauvais jeu"
    tl.TextColor3 = Color3.fromRGB(255,255,255)
    tl.TextTransparency = 1
    tl.TextSize = 17
    tl.TextXAlignment = Enum.TextXAlignment.Left
    tl.Parent = card

    local bl = Instance.new("TextLabel")
    bl.BackgroundTransparency = 1
    bl.Position = UDim2.fromOffset(22,52)
    bl.Size = UDim2.fromOffset(316,42)
    bl.Font = Enum.Font.Gotham
    bl.Text = "KuraiMoka fonctionne uniquement dans Murder Mystery 2.\nRejoins un serveur MM2 et relance le script."
    bl.TextColor3 = Color3.fromRGB(150,150,165)
    bl.TextTransparency = 1
    bl.TextSize = 13
    bl.TextXAlignment = Enum.TextXAlignment.Left
    bl.TextWrapped = true
    bl.Parent = card

    local okBtn = Instance.new("TextButton")
    okBtn.AnchorPoint = Vector2.new(1,1)
    okBtn.Position = UDim2.new(1,-22,1,-18)
    okBtn.Size = UDim2.fromOffset(80,30)
    okBtn.BackgroundColor3 = Color3.fromRGB(190,28,48)
    okBtn.BackgroundTransparency = 1
    okBtn.BorderSizePixel = 0
    okBtn.Font = Enum.Font.GothamBold
    okBtn.Text = "OK"
    okBtn.TextColor3 = Color3.fromRGB(255,255,255)
    okBtn.TextTransparency = 1
    okBtn.TextSize = 13
    okBtn.AutoButtonColor = false
    okBtn.Parent = card
    Instance.new("UICorner", okBtn).CornerRadius = UDim.new(0,8)

    local ti = TweenInfo.new(0.22, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(shade, ti, {BackgroundTransparency = 0.55}):Play()
    TweenService:Create(card, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0
    }):Play()
    TweenService:Create(cs, ti, {Transparency = 0.35}):Play()
    task.delay(0.05, function()
        TweenService:Create(tl, ti, {TextTransparency = 0}):Play()
        TweenService:Create(bl, ti, {TextTransparency = 0}):Play()
        TweenService:Create(okBtn, ti, {BackgroundTransparency = 0, TextTransparency = 0}):Play()
    end)

    okBtn.MouseEnter:Connect(function() TweenService:Create(okBtn,ti,{BackgroundColor3=Color3.fromRGB(230,50,70)}):Play() end)
    okBtn.MouseLeave:Connect(function() TweenService:Create(okBtn,ti,{BackgroundColor3=Color3.fromRGB(190,28,48)}):Play() end)
    okBtn.MouseButton1Click:Connect(function() pcall(function() sg:Destroy() end) end)
    return
end

