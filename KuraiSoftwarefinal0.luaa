        LocalPlayer:LoadCharacter(); Notify("Respawn","Fait ✓","info")
    end)
    MkButton(p,"Reset Vitesse/Saut","Remet WS=16 JP=50",false,function()
        flags.walkSpeedOn=false; flags.jumpPowerOn=false
        local h=myHum(); if h then h.WalkSpeed=16; h.UseJumpPower=true; h.JumpPower=50 end
        Notify("Reset","Vitesse et saut réinitialisés","success")
    end)
end

