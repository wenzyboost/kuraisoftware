local Log = {}
function Log.Info(msg)
    if CFG.Debug then print("[KuraiSW] INFO: " .. tostring(msg)) end
end
function Log.Warn(msg)
    if CFG.Debug then warn("[KuraiSW] WARN: " .. tostring(msg)) end
end
function Log.Err(msg)
    warn("[KuraiSW] ERR: " .. tostring(msg))
end

