        CFG.Webhook.URL = v
    end)

    Toggle(p, "Webhook Activé",          nil, false, function(v) CFG.Webhook.Enabled  = v end)
    Toggle(p, "Log Kills",               nil, false, function(v) CFG.Webhook.LogKills  = v end)
    Toggle(p, "Log Rôle Chaque Round",   nil, false, function(v) CFG.Webhook.LogRole   = v end)

    Spacer(4, p)
    Button(p, "Test Message", "📨", function()
        if CFG.Webhook.URL == "" then
            Notify("Webhook", "Aucune URL configurée", 3)
            return
        end
        local ok = pcall(function()
            local payload = HttpService:JSONEncode({
                username = CFG.Name,
                content  = "✅ Test depuis **" .. CFG.Name .. " " .. CFG.Version .. "** — joueur: **" .. LP.Name .. "**",
            })
            local r = (syn and syn.request) or request
            if r then
                r({
                    Url     = CFG.Webhook.URL,
                    Method  = "POST",
                    Headers = {["Content-Type"] = "application/json"},
                    Body    = payload,
                })
            end
        end)
        Notify("Webhook", ok and "Envoyé ✓" or "Erreur envoi", 4)
    end)
end

