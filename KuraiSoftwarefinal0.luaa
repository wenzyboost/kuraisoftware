-- PAGE: DASHBOARD
do
    local p = Pages["Dashboard"]
    Section(p,"Statut Joueur")

    local statsWrap = New("Frame",{BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.new(1,0,0,152)},p)
    New("UIGridLayout",{SortOrder=Enum.SortOrder.LayoutOrder,CellSize=UDim2.new(0.5,-4,0,72),
        CellPaddingHorizontal=UDim.new(0,4),CellPaddingVertical=UDim.new(0,4)},statsWrap)

    local function StatCard(parent, icon, label, color)
        local card = New("Frame",{BackgroundColor3=T.Bg3,BorderSizePixel=0},parent)
        Corner(10,card)
        local ib = New("Frame",{BackgroundColor3=color,BackgroundTransparency=0.8,BorderSizePixel=0,
            Position=UDim2.fromOffset(10,10),Size=UDim2.fromOffset(30,30)},card)
        Corner(8,ib)
        New("TextLabel",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Font=Enum.Font.GothamBold,
            Text=icon,TextColor3=color,TextSize=16},ib)
        local vL = New("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(48,8),
            Size=UDim2.new(1,-58,0,24),Font=Enum.Font.GothamBold,Text="—",TextColor3=T.TextPrim,
            TextSize=18,TextXAlignment=Enum.TextXAlignment.Left},card)
        New("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(48,34),
            Size=UDim2.new(1,-58,0,14),Font=Enum.Font.Gotham,Text=label,TextColor3=T.TextMuted,
            TextSize=10,TextXAlignment=Enum.TextXAlignment.Left},card)
        return vL
    end

    local fpsLbl   = StatCard(statsWrap,"⚡","FPS",         T.Success)
    local pingLbl  = StatCard(statsWrap,"📡","Ping",        T.Info)
    local hpLbl    = StatCard(statsWrap,"❤","Santé",        T.Error)
    local speedLbl = StatCard(statsWrap,"🏃","Vitesse",     T.Warning)

    Spacer(p,4); Section(p,"Mon Rôle")
    local roleCard = New("Frame",{BackgroundColor3=T.Bg3,BorderSizePixel=0,Size=UDim2.new(1,0,0,66)},p)
    Corner(10,roleCard)
    local roleDot = New("Frame",{BackgroundColor3=T.TextMuted,BorderSizePixel=0,
        Position=UDim2.new(0,14,0.5,-20),Size=UDim2.fromOffset(40,40)},roleCard)
    Corner(99,roleDot)
    local roleIconLbl = New("TextLabel",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),
        Font=Enum.Font.GothamBold,Text="❓",TextSize=22},roleDot)
    local roleNameLbl = New("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(64,10),
        Size=UDim2.new(1,-78,0,22),Font=Enum.Font.GothamBold,Text="INCONNU",TextColor3=T.TextMuted,
        TextSize=18,TextXAlignment=Enum.TextXAlignment.Left},roleCard)
    local roleSubLbl = New("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(64,32),
        Size=UDim2.new(1,-78,0,14),Font=Enum.Font.Gotham,Text="En attente...",
        TextColor3=T.TextMuted,TextSize=10,TextXAlignment=Enum.TextXAlignment.Left},roleCard)

    Spacer(p,4); Section(p,"Modules Rapides")
    local modGrid = New("Frame",{BackgroundTransparency=1,BorderSizePixel=0,Size=UDim2.new(1,0,0,76)},p)
    New("UIGridLayout",{SortOrder=Enum.SortOrder.LayoutOrder,CellSize=UDim2.new(0.5,-4,0,36),
        CellPaddingHorizontal=UDim.new(0,4),CellPaddingVertical=UDim.new(0,4)},modGrid)

    local quickMods = {
        {name="ESP Nametags", flag="espNames"},
        {name="Chams ESP",    flag="espChams"},
        {name="Fly",          flag="fly",     onToggle=function(v) if v then startFly() else stopFly() end end},
        {name="Auto Kill",    flag="autoKill"},
    }
    for i, md in ipairs(quickMods) do
        local mb = New("TextButton",{BackgroundColor3=flags[md.flag] and T.AccentDim or T.Bg3,
            BorderSizePixel=0,LayoutOrder=i,Text="",AutoButtonColor=false},modGrid)
        Corner(8,mb)
        local lbl = New("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(10,0),
            Size=UDim2.new(1,-12,1,0),Font=Enum.Font.Gotham,Text=md.name,
            TextColor3=flags[md.flag] and T.AccentGlow or T.TextSec,TextSize=12,
            TextXAlignment=Enum.TextXAlignment.Left},mb)
        mb.MouseButton1Click:Connect(function()
            flags[md.flag] = not flags[md.flag]
            local on = flags[md.flag]
            TW(mb,AI_FAST,{BackgroundColor3=on and T.AccentDim or T.Bg3})
            lbl.TextColor3 = on and T.AccentGlow or T.TextSec
            if md.onToggle then md.onToggle(on) end
            Notify(md.name, on and "ON" or "OFF", on and "success" or "info")
        end)
    end

    -- Dashboard loop
    local dashT = 0
    bind(RunService.Heartbeat, function(dt)
        dashT = dashT + dt
        if dashT < 0.5 or ActiveTab ~= "Dashboard" then return end
        dashT = 0
        fpsLbl.Text = tostring(math.floor(1/dt))
        pcall(function()
            local s = game:GetService("Stats")
            local ping = math.floor(s.Network.ServerStatsItem["Data Ping"]:GetValue())
            pingLbl.Text = ping.."ms"
            pingLbl.TextColor3 = ping<80 and T.Success or ping<150 and T.Warning or T.Error
        end)
        local h = myHum()
        if h then
            hpLbl.Text = math.floor(h.Health).."/"..math.floor(h.MaxHealth)
            speedLbl.Text = tostring(math.floor(h.WalkSpeed))
        end
        local mr = myRole()
        local mc = roleColor(mr)
        local micons = {Murder="🔪",Sheriff="⭐",Hero="⭐",Innocent="👤",Unknown="❓"}
        roleNameLbl.Text = mr:upper(); roleNameLbl.TextColor3 = mc
        roleDot.BackgroundColor3 = mc
        roleIconLbl.Text = micons[mr] or "❓"
        roleSubLbl.Text = "Détecté localement"
    end)
end

-- PAGE: COMBAT
do
    local p = Pages["Combat"]
