-- ╔══════════════════════════════════╗
-- ║         TAB: CROSSHAIR           ║
-- ╚══════════════════════════════════╝
do
    local p = Pages["Crosshair"]

    Section("Activation", p)
    Toggle(p, "Crosshair Custom", nil, S.CrosshairOn, function(v)
        S.CrosshairOn = v
        if not v then
            for _, d in pairs(CH) do d.Visible = false end
        end
    end)
    Toggle(p, "Spin Crosshair", nil, S.CrosshairSpin, function(v)
        S.CrosshairSpin = v
    end)

    Spacer(4, p)
    Section("Style", p)
