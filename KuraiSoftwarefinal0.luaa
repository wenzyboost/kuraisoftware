do
    local p = Pages["Skybox"]
    Section("Skybox Picker", p)

    local SKYBOXES = {
        {n = "Space Noir",    id = "159454286"},
        {n = "Sunset Rouge",  bk = "2235302752", dn = "2235302748", ft = "2235302756", lf = "2235302744", rt = "2235302760", up = "2235302726"},
        {n = "Nuit Étoilée",  id = "151454774"},
    }

    for _, sk in ipairs(SKYBOXES) do
        Button(p, sk.n, "›", function()
            local old = Lighting:FindFirstChildOfClass("Sky")
            if old then old:Destroy() end
            local sky = Instance.new("Sky")
            if sk.id then
                local asset = "rbxassetid://" .. sk.id
                sky.SkyboxBk = asset; sky.SkyboxDn = asset
                sky.SkyboxFt = asset; sky.SkyboxLf = asset
                sky.SkyboxRt = asset; sky.SkyboxUp = asset
            else
                sky.SkyboxBk = "rbxassetid://" .. sk.bk
                sky.SkyboxDn = "rbxassetid://" .. sk.dn
                sky.SkyboxFt = "rbxassetid://" .. sk.ft
                sky.SkyboxLf = "rbxassetid://" .. sk.lf
                sky.SkyboxRt = "rbxassetid://" .. sk.rt
                sky.SkyboxUp = "rbxassetid://" .. sk.up
            end
            sky.Parent = Lighting
            Notify("Skybox", sk.n .. " ✓")
        end)
    end
    Spacer(4, p)
    Button(p, "Supprimer Skybox", "✕", function()
        local s = Lighting:FindFirstChildOfClass("Sky")
        if s then s:Destroy() end
        Notify("Skybox", "Supprimé")
    end)
end

