local function Section(parent, title)
    local f = New("Frame", {BackgroundTransparency=1, Size=UDim2.new(1,0,0,30)}, parent)
    New("TextLabel", {
        BackgroundTransparency=1, Position=UDim2.fromOffset(2,10), Size=UDim2.new(1,-4,0,14),
        Font=Enum.Font.GothamBold, Text=title:upper(), TextColor3=T.Accent, TextSize=10,
        TextXAlignment=Enum.TextXAlignment.Left,
    }, f)
    New("Frame", {BackgroundColor3=T.Sep,BorderSizePixel=0,Position=UDim2.new(0,0,1,-1),Size=UDim2.new(1,0,0,1)}, f)
    return f
end

local function Spacer(p, h)
    return New("Frame", {BackgroundTransparency=1, Size=UDim2.new(1,0,0,h or 6)}, p)
end

local function MkToggle(parent, title, sub, val, cb)
    local rowH = sub and 56 or 46
    local row = New("Frame", {BackgroundColor3=T.Bg3,BorderSizePixel=0,Size=UDim2.new(1,0,0,rowH)}, parent)
    Corner(10, row)
    New("TextLabel", {
        BackgroundTransparency=1, Position=UDim2.new(0,14,0,sub and 8 or 0), Size=UDim2.new(1,-78,0,22),
        Font=Enum.Font.Gotham, Text=title, TextColor3=T.TextPrim, TextSize=13,
        TextXAlignment=Enum.TextXAlignment.Left,
    }, row)
    if sub then
        New("TextLabel", {
            BackgroundTransparency=1, Position=UDim2.new(0,14,0,30), Size=UDim2.new(1,-78,0,16),
            Font=Enum.Font.Gotham, Text=sub, TextColor3=T.TextMuted, TextSize=10,
            TextXAlignment=Enum.TextXAlignment.Left,
        }, row)
    end
    local track = New("Frame", {
        BackgroundColor3=val and T.TogOn or T.TogOff, BorderSizePixel=0,
        Position=UDim2.new(1,-60,0.5,-12), Size=UDim2.fromOffset(46,24),
    }, row)
    Corner(99, track)
    local thumb = New("Frame", {
        BackgroundColor3=T.TextPrim, BorderSizePixel=0,
        Position=val and UDim2.new(1,-22,0.5,-10) or UDim2.new(0,2,0.5,-10),
        Size=UDim2.fromOffset(20,20),
    }, track)
    Corner(99, thumb)
    local btn = New("TextButton", {BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Text="",ZIndex=6}, row)
    local function SetV(v)
        val = v
        TW(track,AI_FAST,{BackgroundColor3=v and T.TogOn or T.TogOff})
        TW(thumb,AI_FAST,{Position=v and UDim2.new(1,-22,0.5,-10) or UDim2.new(0,2,0.5,-10)})
    end
    btn.MouseButton1Click:Connect(function()
        SetV(not val)
        TW(row,AI_FAST,{BackgroundColor3=T.Bg4})
        task.delay(0.1, function() TW(row,AI_FAST,{BackgroundColor3=T.Bg3}) end)
        if cb then Safe(cb, val) end
    end)
    btn.MouseEnter:Connect(function() TW(row,AI_FAST,{BackgroundColor3=T.Bg4}) end)
    btn.MouseLeave:Connect(function() TW(row,AI_FAST,{BackgroundColor3=T.Bg3}) end)
    return row, SetV
end

local function MkSlider(parent, title, min, max, def, cb, suffix)
    suffix = suffix or ""
    local cur = def
    local row = New("Frame",{BackgroundColor3=T.Bg3,BorderSizePixel=0,Size=UDim2.new(1,0,0,68)},parent)
    Corner(10,row)
    New("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(14,8),Size=UDim2.new(0.65,0,0,22),
        Font=Enum.Font.Gotham,Text=title,TextColor3=T.TextPrim,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left},row)
    local vbg=New("Frame",{BackgroundColor3=T.Bg0,BorderSizePixel=0,Position=UDim2.new(1,-64,0,8),Size=UDim2.fromOffset(52,22)},row)
    Corner(7,vbg)
    local vLbl=New("TextLabel",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Font=Enum.Font.GothamBold,
        Text=tostring(def)..suffix,TextColor3=T.Accent,TextSize=12},vbg)
    local trBg=New("Frame",{BackgroundColor3=Color3.fromRGB(28,28,44),BorderSizePixel=0,
        Position=UDim2.new(0,14,0,46),Size=UDim2.new(1,-28,0,6)},row)
    Corner(99,trBg)
    local pct=(cur-min)/(max-min)
    local fill=New("Frame",{BackgroundColor3=T.Accent,BorderSizePixel=0,Size=UDim2.new(pct,0,1,0)},trBg)
    Corner(99,fill)
    local knob=New("Frame",{BackgroundColor3=T.TextPrim,BorderSizePixel=0,
        Position=UDim2.new(pct,-9,0.5,-9),Size=UDim2.fromOffset(18,18),ZIndex=4},trBg)
    Corner(99,knob)
    Stroke(T.Sep,1.5,knob)
    local dragging=false
    local function UpdateAt(x)
        local ap=trBg.AbsolutePosition.X; local as=trBg.AbsoluteSize.X
        local r=math.clamp((x-ap)/as,0,1)
        cur=math.floor(min+(max-min)*r)
        fill.Size=UDim2.new(r,0,1,0); knob.Position=UDim2.new(r,-9,0.5,-9)
        vLbl.Text=tostring(cur)..suffix
        if cb then Safe(cb,cur) end
    end
    trBg.InputBegan:Connect(function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=true; UpdateAt(i.Position.X) end
    end)
    bind(UserInputService.InputChanged,function(i)
        if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then UpdateAt(i.Position.X) end
    end)
    bind(UserInputService.InputEnded,function(i)
        if i.UserInputType==Enum.UserInputType.MouseButton1 then dragging=false end
    end)
    row.MouseEnter:Connect(function() TW(row,AI_FAST,{BackgroundColor3=T.Bg4}) end)
    row.MouseLeave:Connect(function() TW(row,AI_FAST,{BackgroundColor3=T.Bg3}) end)
    return row
end

local function MkButton(parent, title, sub, accent, cb)
    local rowH = sub and 54 or 44
    local row = New("Frame",{BackgroundColor3=accent and T.AccentDim or T.Bg3,BorderSizePixel=0,Size=UDim2.new(1,0,0,rowH)},parent)
    Corner(10,row)
    if accent then Stroke(T.Accent,1,row) end
    local tx = 14
    New("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,tx,0,sub and 8 or 0),
        Size=UDim2.new(1,-(tx+14),0,22),Font=Enum.Font.Gotham,Text=title,TextColor3=T.TextPrim,
        TextSize=13,TextXAlignment=Enum.TextXAlignment.Left},row)
    if sub then
        New("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0,tx,0,30),
            Size=UDim2.new(1,-(tx+14),0,16),Font=Enum.Font.Gotham,Text=sub,TextColor3=T.TextMuted,
            TextSize=10,TextXAlignment=Enum.TextXAlignment.Left},row)
    end
    New("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(1,-28,0,0),Size=UDim2.fromOffset(20,1),
        SizeConstraint=Enum.SizeConstraint.RelativeYY,
        Font=Enum.Font.GothamBold,Text="›",TextColor3=T.TextMuted,TextSize=18},row)
    local btn = New("TextButton",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Text="",ZIndex=6},row)
    btn.MouseEnter:Connect(function() TW(row,AI_FAST,{BackgroundColor3=accent and T.AccentDim or T.Bg4}) end)
    btn.MouseLeave:Connect(function() TW(row,AI_FAST,{BackgroundColor3=accent and T.AccentDim or T.Bg3}) end)
    btn.MouseButton1Click:Connect(function()
        TW(row,AI_FAST,{BackgroundColor3=T.Bg0})
        task.delay(0.12,function() TW(row,AI_FAST,{BackgroundColor3=accent and T.AccentDim or T.Bg3}) end)
        if cb then Safe(cb) end
    end)
    return row
end

local function MkPicker(parent, title, opts, def, cb)
    local sel=def or opts[1] or ""
    local open=false
    local IH=30; local dropH=#opts*IH+8
    local container=New("Frame",{BackgroundTransparency=1,Size=UDim2.new(1,0,0,46),ZIndex=8,ClipsDescendants=false},parent)
    local row=New("Frame",{BackgroundColor3=T.Bg3,BorderSizePixel=0,Size=UDim2.new(1,0,0,46),ZIndex=8},container)
    Corner(10,row)
    New("TextLabel",{BackgroundTransparency=1,Position=UDim2.fromOffset(14,0),Size=UDim2.new(0.55,0,1,0),
        Font=Enum.Font.Gotham,Text=title,TextColor3=T.TextPrim,TextSize=13,TextXAlignment=Enum.TextXAlignment.Left,ZIndex=9},row)
    local selLbl=New("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(0.55,0,0,0),Size=UDim2.new(0.45,-38,1,0),
        Font=Enum.Font.Gotham,Text=sel,TextColor3=T.TextSec,TextSize=12,TextXAlignment=Enum.TextXAlignment.Right,ZIndex=9},row)
    New("TextLabel",{BackgroundTransparency=1,Position=UDim2.new(1,-34,0,0),Size=UDim2.fromOffset(24,1),
        SizeConstraint=Enum.SizeConstraint.RelativeYY,
        Font=Enum.Font.GothamBold,Text="⌄",TextColor3=T.Accent,TextSize=18,ZIndex=9},row)
    local drop=New("Frame",{BackgroundColor3=T.Bg2,BorderSizePixel=0,Position=UDim2.fromOffset(0,48),
        Size=UDim2.new(1,0,0,dropH),Visible=false,ZIndex=20,ClipsDescendants=false},container)
    Corner(10,drop); Stroke(T.Sep,1,drop)
    List(0,drop); New("UIPadding",{PaddingLeft=UDim.new(0,4),PaddingRight=UDim.new(0,4),PaddingTop=UDim.new(0,4),PaddingBottom=UDim.new(0,4)},drop)
    for _,opt in ipairs(opts) do
        local isA=opt==sel
        local ob=New("TextButton",{BackgroundColor3=isA and T.AccentDim or Color3.new(0,0,0),
            BackgroundTransparency=isA and 0 or 1,BorderSizePixel=0,Size=UDim2.new(1,0,0,IH),
            Font=Enum.Font.Gotham,Text=opt,TextColor3=isA and T.AccentGlow or T.TextSec,TextSize=12,ZIndex=21},drop)
        Corner(7,ob)
        ob.MouseEnter:Connect(function() if opt~=sel then TW(ob,AI_FAST,{BackgroundTransparency=0,BackgroundColor3=T.Bg4}) end end)
        ob.MouseLeave:Connect(function() if opt~=sel then TW(ob,AI_FAST,{BackgroundTransparency=1}) end end)
        ob.MouseButton1Click:Connect(function()
            sel=opt; selLbl.Text=opt; open=false; drop.Visible=false
            container.Size=UDim2.new(1,0,0,46)
            if cb then Safe(cb,opt) end
        end)
    end
    local hbtn=New("TextButton",{BackgroundTransparency=1,Size=UDim2.fromScale(1,1),Text="",ZIndex=10},row)
    hbtn.MouseEnter:Connect(function() TW(row,AI_FAST,{BackgroundColor3=T.Bg4}) end)
    hbtn.MouseLeave:Connect(function() TW(row,AI_FAST,{BackgroundColor3=T.Bg3}) end)
    hbtn.MouseButton1Click:Connect(function()
        open=not open; drop.Visible=open
        container.Size=UDim2.new(1,0,0,open and 46+dropH+6 or 46)
    end)
    return container
end

