local _notifSeq  = 0
local _notifStack = {}
local NOTIF_MAX  = 5
local NOTIF_COLORS = {success=T.Success, info=T.Info, warning=T.Warning, error=T.Error}
local NOTIF_ICONS  = {success="✓", info="ℹ", warning="⚠", error="✕"}

local function Notify(title, msg, ntype, dur)
    ntype = ntype or "info"
    dur   = dur   or 4
    if #_notifStack >= NOTIF_MAX then
        local old = table.remove(_notifStack, 1)
        if old and old.Parent then old:Destroy() end
    end
    _notifSeq = _notifSeq + 1
    local col  = NOTIF_COLORS[ntype] or T.Info
    local icon = NOTIF_ICONS[ntype] or "ℹ"

    local card = New("Frame", {
        Name = "KM_Notif",
        BackgroundColor3 = T.Bg2,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1,0,0,66),
        BackgroundTransparency = 1,
        LayoutOrder = _notifSeq,
        ZIndex = 101,
    }, NotifHolder)
    Corner(10, card)

    New("Frame", {
        BackgroundColor3 = col, BorderSizePixel = 0,
        Position = UDim2.new(0,0,0,0), Size = UDim2.new(0,3,1,0), ZIndex = 102,
    }, card)

    local ibg = New("Frame", {
        BackgroundColor3 = col, BackgroundTransparency = 0.75,
        BorderSizePixel = 0,
        Position = UDim2.new(0,10,0.5,-13), Size = UDim2.fromOffset(26,26), ZIndex = 102,
    }, card)
    Corner(99, ibg)
    New("TextLabel", {
        BackgroundTransparency = 1, Size = UDim2.fromScale(1,1),
        Font = Enum.Font.GothamBold, Text = icon,
        TextColor3 = col, TextSize = 13, ZIndex = 103,
    }, ibg)

    New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0,44,0,10), Size = UDim2.new(1,-56,0,20),
        Font = Enum.Font.GothamBold, Text = tostring(title),
        TextColor3 = T.TextPrim, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 102,
    }, card)

    New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0,44,0,30), Size = UDim2.new(1,-56,0,26),
        Font = Enum.Font.Gotham, Text = tostring(msg),
        TextColor3 = T.TextSec, TextSize = 11, TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 102,
    }, card)

    local prog = New("Frame", {
        BackgroundColor3 = col, BackgroundTransparency = 0.4,
        BorderSizePixel = 0,
        Position = UDim2.new(0,4,1,-3), Size = UDim2.new(1,-8,0,2), ZIndex = 102,
    }, card)
    Corner(2, prog)

    table.insert(_notifStack, card)
    TW(card, AI_SPRING, {BackgroundTransparency = 0})
    TW(prog, TweenInfo.new(dur, Enum.EasingStyle.Linear), {Size = UDim2.new(0,0,0,2)})

    task.delay(dur, function()
        if not card or not card.Parent then return end
        TW(card, AI_MED, {BackgroundTransparency = 1, Position = UDim2.new(1,8,0,0)})
        task.delay(0.26, function()
            if card and card.Parent then
                local idx = table.find(_notifStack, card)
                if idx then table.remove(_notifStack, idx) end
                card:Destroy()
            end
        end)
    end)
end

