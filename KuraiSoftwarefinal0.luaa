    MkToggle(p,"Auto Kill","Couteau instant (murderer) ou snap-shot (sheriff)",false,function(v)
        flags.autoKill=v; Notify("Auto Kill",v and "ON" or "OFF",v and "success" or "info")
    end)
    MkToggle(p,"Aimbot","Snap caméra vers l'ennemi le plus proche dans le FOV",false,function(v) flags.aimbot=v end)
    MkToggle(p,"Silent Aim","Redirige les tirs/lancers silencieusement",false,function(v) flags.silentAim=v end)
    MkToggle(p,"Afficher Cercle FOV",nil,false,function(v) flags.showFov=v end)
    MkSlider(p,"FOV Rayon",40,400,120,function(v) aimFov=v end,"px")

    Spacer(p,4); Section(p,"Sheriff")
