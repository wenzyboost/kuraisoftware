-- [[ AR-AI v4.0 — Stable, No Hook, Arena Deagle ]]
-- Medium Executor | Toggle: LeftCtrl

local Players          = game:GetService("Players")
local RunService       = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService     = game:GetService("TweenService")
local Camera           = workspace.CurrentCamera
local LocalPlayer      = Players.LocalPlayer

local Config = {
    ESP    = { Enabled = true,  MaxDist = 1500 },
    Aimbot = { Enabled = true,  FOV = 200, Smooth = 0.15, Predict = true },
}

-- ══ UTILS ══
local function getHead(p)
    local c = p.Character
    return c and c:FindFirstChild("Head")
end
local function getRoot(p)
    local c = p.Character
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function getHum(p)
    local c = p.Character
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function alive(p)
    local h = getHum(p)
    return h and h.Health > 0
end
local function toVP(pos)
    local s, on = Camera:WorldToViewportPoint(pos)
    return Vector2.new(s.X, s.Y), on
end
local function getBest()
    local best, bestD = nil, Config.Aimbot.FOV
    local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and alive(p) then
            local h = getHead(p)
            if h then
                local sp, on = toVP(h.Position)
                if on then
                    local d = (center - sp).Magnitude
                    if d < bestD then bestD=d; best=p end
                end
            end
        end
    end
    return best
end

-- ══ ESP (Drawing pur, zero hook) ══
local ESPs = {}

local function makeESP(p)
    local box = Drawing.new("Square")
    box.Visible=false; box.Color=Color3.fromRGB(255,50,50)
    box.Thickness=1.5; box.Filled=false; box.Transparency=1

    local name = Drawing.new("Text")
    name.Visible=false; name.Color=Color3.fromRGB(255,255,255)
    name.Size=13; name.Center=true; name.Outline=true
    name.OutlineColor=Color3.fromRGB(0,0,0)

    local hpBg = Drawing.new("Square")
    hpBg.Visible=false; hpBg.Color=Color3.fromRGB(30,30,30)
    hpBg.Thickness=1; hpBg.Filled=true; hpBg.Transparency=0.6

    local hpBar = Drawing.new("Square")
    hpBar.Visible=false; hpBar.Thickness=1
    hpBar.Filled=true; hpBar.Transparency=0.8

    local tracer = Drawing.new("Line")
    tracer.Visible=false; tracer.Color=Color3.fromRGB(255,100,0); tracer.Thickness=1

    ESPs[p] = {box=box, name=name, hpBg=hpBg, hpBar=hpBar, tracer=tracer}
end

local function hideESP(p)
    if not ESPs[p] then return end
    for _, o in pairs(ESPs[p]) do
        pcall(function() o.Visible = false end)
    end
end

local function clearESP(p)
    if not ESPs[p] then return end
    for _, o in pairs(ESPs[p]) do pcall(function() o:Remove() end) end
    ESPs[p] = nil
end

local function tickESP()
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LocalPlayer then continue end
        if not ESPs[p] then makeESP(p) end
        local o = ESPs[p]

        if not Config.ESP.Enabled or not alive(p) then
            hideESP(p); continue
        end

        local root = getRoot(p)
        local head = getHead(p)
        local hum  = getHum(p)
        if not root or not head or not hum then hideESP(p); continue end

        local dist = (Camera.CFrame.Position - root.Position).Magnitude
        if dist > Config.ESP.MaxDist then hideESP(p); continue end

        local top, topOn = toVP(head.Position + Vector3.new(0, 1.2, 0))
        local bot, botOn = toVP(root.Position - Vector3.new(0, 3.2, 0))

        if not (topOn or botOn) then hideESP(p); continue end

        local h = math.abs(bot.Y - top.Y)
        local w = h * 0.45
        local x = top.X - w/2

        -- Box
        o.box.Visible  = true
        o.box.Size     = Vector2.new(w, h)
        o.box.Position = Vector2.new(x, top.Y)

        -- Nom
        o.name.Visible   = true
        o.name.Text      = p.Name .. " [" .. math.floor(dist) .. "m]"
        o.name.Position  = Vector2.new(top.X, top.Y - 14)

        -- Health bar
        local ratio = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
        o.hpBg.Visible   = true
        o.hpBg.Size      = Vector2.new(4, h)
        o.hpBg.Position  = Vector2.new(x - 7, top.Y)

        o.hpBar.Visible  = true
        o.hpBar.Size     = Vector2.new(4, h * ratio)
        o.hpBar.Position = Vector2.new(x - 7, top.Y + h * (1 - ratio))
        o.hpBar.Color    = Color3.fromRGB(
            math.floor((1 - ratio) * 255),
            math.floor(ratio * 255), 0
        )

        -- Tracer
        o.tracer.Visible = true
        o.tracer.From    = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y)
        o.tracer.To      = Vector2.new(bot.X, bot.Y)
    end
end

Players.PlayerRemoving:Connect(clearESP)

-- ══ AIMBOT (RenderStepped, pas de hook) ══
RunService.RenderStepped:Connect(function()
    tickESP()
    if not Config.Aimbot.Enabled then return end
    local t = getBest()
    if not t then return end
    local head = getHead(t)
    if not head then return end
    local pos = head.Position
    if Config.Aimbot.Predict then
        local vel = head.AssemblyLinearVelocity or Vector3.zero
        pos = pos + vel * 0.08
    end
    Camera.CFrame = Camera.CFrame:Lerp(
        CFrame.new(Camera.CFrame.Position, pos),
        Config.Aimbot.Smooth
    )
end)

-- ══ GUI ══
local SG = Instance.new("ScreenGui")
SG.Name="ARAI4"; SG.ResetOnSpawn=false
SG.ZIndexBehavior=Enum.ZIndexBehavior.Sibling
SG.Parent=game.CoreGui

local MF = Instance.new("Frame")
MF.Size=UDim2.new(0,300,0,200)
MF.Position=UDim2.new(0.5,-150,-1,0)
MF.BackgroundColor3=Color3.fromRGB(8,8,16)
MF.BorderSizePixel=0; MF.Parent=SG
Instance.new("UICorner",MF).CornerRadius=UDim.new(0,12)

local stroke=Instance.new("UIStroke",MF); stroke.Thickness=2
task.spawn(function()
    local t=0
    while task.wait(0.02) do
        t+=0.06
        stroke.Color=Color3.fromRGB(
            math.floor(math.abs(math.sin(t))*255),0,
            math.floor(math.abs(math.cos(t))*255)
        )
    end
end)

local hdr=Instance.new("Frame",MF)
hdr.Size=UDim2.new(1,0,0,40); hdr.BackgroundColor3=Color3.fromRGB(18,0,36)
hdr.BorderSizePixel=0
Instance.new("UICorner",hdr).CornerRadius=UDim.new(0,10)

local ttl=Instance.new("TextLabel",hdr)
ttl.Size=UDim2.new(1,0,1,0); ttl.BackgroundTransparency=1
ttl.TextColor3=Color3.fromRGB(210,80,255); ttl.Font=Enum.Font.GothamBold
ttl.TextSize=14; ttl.Text="⚡ AR-AI v4.0  |  CTRL = hide"

local drag,ds,sp=false,nil,nil
hdr.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 then
        drag=true; ds=i.Position; sp=MF.Position
    end
end)
UserInputService.InputChanged:Connect(function(i)
    if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
        local d=i.Position-ds
        MF.Position=UDim2.new(sp.X.Scale,sp.X.Offset+d.X,sp.Y.Scale,sp.Y.Offset+d.Y)
    end
end)
UserInputService.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
end)

local pad=Instance.new("UIPadding",MF)
pad.PaddingTop=UDim.new(0,48); pad.PaddingLeft=UDim.new(0,10)
pad.PaddingRight=UDim.new(0,10); pad.PaddingBottom=UDim.new(0,10)

local layout=Instance.new("UIListLayout",MF)
layout.SortOrder=Enum.SortOrder.LayoutOrder; layout.Padding=UDim.new(0,8)

local function makeBtn(label, cfg, key)
    local b=Instance.new("TextButton",MF)
    b.Size=UDim2.new(1,0,0,38)
    b.BackgroundColor3=cfg[key] and Color3.fromRGB(65,0,110) or Color3.fromRGB(20,20,30)
    b.TextColor3=Color3.fromRGB(240,240,255); b.Font=Enum.Font.GothamSemibold
    b.TextSize=14; b.AutoButtonColor=false
    b.Text=(cfg[key] and "✅  " or "❌  ")..label
    Instance.new("UICorner",b).CornerRadius=UDim.new(0,8)
    b.MouseButton1Click:Connect(function()
        cfg[key]=not cfg[key]
        b.Text=(cfg[key] and "✅  " or "❌  ")..label
        b.BackgroundColor3=cfg[key] and Color3.fromRGB(65,0,110) or Color3.fromRGB(20,20,30)
    end)
end

makeBtn("ESP + Health Bar", Config.ESP,    "Enabled")
makeBtn("Aimbot",           Config.Aimbot, "Enabled")

-- CTRL toggle
UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode==Enum.KeyCode.LeftControl then
        MF.Visible=not MF.Visible
    end
end)

-- Entrance
TweenService:Create(MF,
    TweenInfo.new(0.6,Enum.EasingStyle.Back,Enum.EasingDirection.Out),
    {Position=UDim2.new(0.5,-150,0.5,-100)}
):Play()

print("[AR-AI v4.0] OK — CTRL toggle")
