-- ══════════════════════════════════════════════
--  TAB: GRAPHICS
-- ══════════════════════════════════════════════
do
    local p = Pages["Graphics"]

    Section("Qualité", p)
    Toggle(p, "Low Graphics (FPS Max)", nil, CFG.Graphics.LowGfx, function(v)
        CFG.Graphics.LowGfx = v
        if v then
            settings().Rendering.QualityLevel = Enum.QualityLevel.Level01
            for _, ef in ipairs(Lighting:GetDescendants()) do
                if ef:IsA("PostEffect") then ef.Enabled = false end
            end
        else
            settings().Rendering.QualityLevel = Enum.QualityLevel.Automatic
            for _, ef in ipairs(Lighting:GetDescendants()) do
                if ef:IsA("PostEffect") then ef.Enabled = true end
            end
        end
    end)
    Toggle(p, "High Graphics", nil, CFG.Graphics.HighGfx, function(v)
        CFG.Graphics.HighGfx = v
        if v then settings().Rendering.QualityLevel = Enum.QualityLevel.Level21 end
    end)

    Spacer(4, p)
    Section("FOV", p)
    Slider(p, "FOV", 30, 140, CFG.Graphics.FOV, function(v)
        CFG.Graphics.FOV = v
        Cam.FieldOfView  = v
    end, "°")

    Spacer(4, p)
    Section("Stretch", p)
    Toggle(p, "Stretch Resolution", "Mode 4:3 stretched", false, function(v)
        CFG.Graphics.Stretched = v
        if v then
            local vp = Cam.ViewportSize
            local sw = vp.Y * CFG.Graphics.StretchVal
            Cam.DiagonalFieldOfView = math.deg(2 * math.atan(
                math.tan(math.rad(CFG.Graphics.FOV) / 2) * sw / vp.X
            ))
        else
            Cam.FieldOfView = CFG.Graphics.FOV
        end
    end)
    Slider(p, "Stretch Factor", 8, 18, math.floor(CFG.Graphics.StretchVal * 10), function(v)
        CFG.Graphics.StretchVal = v / 10
        if CFG.Graphics.Stretched then
            local vp = Cam.ViewportSize
            local sw = vp.Y * CFG.Graphics.StretchVal
            Cam.DiagonalFieldOfView = math.deg(2 * math.atan(
                math.tan(math.rad(CFG.Graphics.FOV) / 2) * sw / vp.X
            ))
        end
    end)
end

