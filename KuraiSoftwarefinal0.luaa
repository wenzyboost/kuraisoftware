    MkToggle(p,"Limite Distance ESP","Masque les ESP trop loin",false,function(v) flags.espMaxDist=v and KM.espLimit or 0 end)
    MkSlider(p,"Distance Max",25,1000,250,function(v) KM.espLimit=v; if flags.espMaxDist~=0 then flags.espMaxDist=v end end,"m")

    Spacer(p,4); Section(p,"Monde")
    MkToggle(p,"Coin ESP","Surligne les pièces non collectées",false,function(v) flags.coinEsp=v end)
    MkToggle(p,"Trap ESP","Révèle les pièges du murderer",false,function(v) flags.trapEsp=v end)
    MkToggle(p,"Kill Feed","Notifie chaque élimination",false,function(v) flags.killFeed=v end)
    MkToggle(p,"Fullbright","Supprime l'obscurité",false,function(v)
        flags.fullbright=v
        if v then
            pcall(function()
                Lighting.Brightness=3; Lighting.ClockTime=14
                Lighting.Ambient=Color3.new(1,1,1); Lighting.OutdoorAmbient=Color3.new(1,1,1)
                Lighting.FogStart=1e6; Lighting.FogEnd=1e6
            end)
        end
    end)
    MkToggle(p,"FPS Boost","Supprime particules, ombres, effets",false,function(v)
        flags.fpsBoost=v
        if v then
            pcall(function() Lighting.GlobalShadows=false end)
            for _, ef in ipairs(Lighting:GetDescendants()) do
                if ef:IsA("PostEffect") then ef.Enabled=false end
            end
        else
            pcall(function() Lighting.GlobalShadows=true end)
            for _, ef in ipairs(Lighting:GetDescendants()) do
                if ef:IsA("PostEffect") then ef.Enabled=true end
            end
        end
        Notify("FPS Boost",v and "ON" or "OFF")
    end)
    MkToggle(p,"Empreintes","Laisse des traces de pas colorées",false,function(v) flags.footsteps=v end)
end

-- PAGE: TELEPORT
do
    local p = Pages["Teleport"]
    Section(p,"Joueurs")

    local _tpTarget = nil
    local plist = {"Aucun"}
    for _, pl in ipairs(KM.plrs) do if pl~=LocalPlayer then table.insert(plist, pl.Name) end end
    MkPicker(p,"Cible",plist,"Aucun",function(v)
        _tpTarget = v=="Aucun" and nil or Players:FindFirstChild(v)
        Notify("Cible",v=="Aucun" and "Désélectionné" or "→ "..v)
    end)

    MkButton(p,"Téléport vers Cible",nil,false,function()
        local root=myRoot()
        local tp = _tpTarget
        if not tp then Notify("Erreur","Aucune cible sélectionnée","warning"); return end
        local tr = tp.Character and getHRP(tp.Character)
        if root and tr then
            KM.markSelfTP(); root.CFrame=tr.CFrame+Vector3.new(2,2,0)
            Notify("Téléport","→ "..(tp.DisplayName or tp.Name),"success")
        end
    end)

    MkButton(p,"Fling Cible","Lance la cible avec la physique",false,function()
        local tp = _tpTarget
        if not tp then Notify("Erreur","Aucune cible","warning"); return end
        local thr = tp.Character and getHRP(tp.Character)
        if thr then
            local bv = Instance.new("BodyVelocity")
            bv.Velocity = Vector3.new(math.random(-300,300),flags.flingPower,math.random(-300,300))
            bv.MaxForce = Vector3.new(1e9,1e9,1e9); bv.Parent = thr; Debris:AddItem(bv,0.2)
            Notify("Fling","→ "..(tp.DisplayName or tp.Name),"success")
        end
    end)

    Spacer(p,4); Section(p,"Pièces")
    MkToggle(p,"Auto Collecte Pièces","Ramasse les pièces automatiquement",false,function(v)
        flags.autoCoins=v
        if v and coinBagFull then Notify("Auto Coins","Bag déjà plein","warning")
        elseif v then Notify("Auto Coins","ON","success") end
    end)
    MkButton(p,"Téléport Pièce la Plus Proche",nil,false,function()
        local hrp = myRoot()
        if not hrp then Notify("Erreur","Pas de personnage","error"); return end
        local pool = #coinCache > 0 and coinCache or freshCoins()
        local best, bd
        for _, c in ipairs(pool) do
            if c.Parent and not coinTaken(c) then
                local d=(c.Position-hrp.Position).Magnitude
                if not bd or d<bd then bd,best=d,c end
            end
        end
        if not best then Notify("Pièces","Aucune pièce disponible","warning"); return end
        KM.markSelfTP(); hrp.CFrame=CFrame.new(best.Position+Vector3.new(0,3,0))
        Notify("Téléport","Pièce la plus proche ✓","success")
    end)

    Spacer(p,4); Section(p,"Serveur")
    MkButton(p,"Rejoin","Reconnecte au même serveur",false,function()
        Notify("Rejoin","Reconnexion...","info")
        pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId,game.JobId,LocalPlayer) end)
    end)
    MkButton(p,"Server Hop","Rejoint un autre serveur",false,function()
        Notify("Server Hop","Recherche d'un serveur...","info")
        task.spawn(function()
            local ok, res = pcall(function()
                return HttpService:JSONDecode(game:HttpGet(
                    "https://games.roblox.com/v1/games/"..game.PlaceId.."/servers/Public?sortOrder=Desc&limit=25"
                ))
            end)
            if not ok or not res or not res.data then Notify("Server Hop","Erreur réseau","error"); return end
            for _, sv in ipairs(res.data) do
                if sv.id and sv.id ~= game.JobId and ((sv.maxPlayers or 0)-(sv.playing or 0)) >= 1 then
                    pcall(function() TeleportService:TeleportToPlaceInstance(game.PlaceId,sv.id,LocalPlayer) end)
                    return
                end
            end
            Notify("Server Hop","Aucun serveur trouvé","warning")
        end)
    end)
end

