local conns = {}
local function bind(sig, fn)
    local c = sig:Connect(fn)
    table.insert(conns, c)
    return c
end

-- ══════════════════════════════════════════════════════════
--  HELPERS PERSONNAGE
-- ══════════════════════════════════════════════════════════
local function getHRP(ch)  return ch and ch:FindFirstChild("HumanoidRootPart") end
local function getHum(ch)  return ch and ch:FindFirstChildOfClass("Humanoid") end
local function myChar()    return LocalPlayer.Character end
local function myRoot()    return getHRP(myChar()) end
local function myHum()     return getHum(myChar()) end

local function badVec(v)
    if typeof(v) ~= "Vector3" then return true end
    if v.X~=v.X or v.Y~=v.Y or v.Z~=v.Z then return true end
    local inf = math.huge
    return v.X==inf or v.X==-inf or v.Y==inf or v.Y==-inf or v.Z==inf or v.Z==-inf
end

local function badCF(cf)
    if typeof(cf) ~= "CFrame" then return true end
    local p = cf.Position
    if badVec(p) then return true end
    return math.abs(p.X) > 1e6 or math.abs(p.Y) > 1e6 or math.abs(p.Z) > 1e6
end

-- ══════════════════════════════════════════════════════════
--  JOUEURS
-- ══════════════════════════════════════════════════════════
function KM.refreshPlrs()
    local ok, list = pcall(function() return Players:GetPlayers() end)
    if ok and type(list) == "table" then KM.plrs = list end
end
KM.refreshPlrs()
bind(Players.PlayerAdded,    KM.refreshPlrs)
bind(Players.PlayerRemoving, function() task.defer(KM.refreshPlrs) end)

-- ══════════════════════════════════════════════════════════
--  RÔLES
-- ══════════════════════════════════════════════════════════
local CRC; pcall(function()
    CRC = require(RS:WaitForChild("Modules"):WaitForChild("CurrentRoundClient"))
end)

local function roundData(plr)
    return CRC and CRC.PlayerData and CRC.PlayerData[plr.Name]
end

function KM.refreshTags()
    for _, tag in ipairs({"Weapon_Gun","Weapon_Knife"}) do
        local m = KM.tagOwners[tag]
        if m then table.clear(m) else m = {}; KM.tagOwners[tag] = m end
        for _, t in ipairs(CollectionService:GetTagged(tag)) do
            local par = t.Parent
            if par then m[par] = true end
        end
    end
end
KM.refreshTags()

local function playerHasTag(plr, tag)
    local m = KM.tagOwners[tag]; if not m then return false end
    local ch = plr.Character
    if ch and m[ch] then return true end
    local bp = plr:FindFirstChildOfClass("Backpack")
    if bp and m[bp] then return true end
    return false
end

local function charHasWeapon(ch, kind)
    for _, t in ipairs(ch:GetChildren()) do
        if t:IsA("Tool") then
            if kind == "Gun"   and (t.Name == "Gun"   or t:FindFirstChild("Shoot"))  then return true end
            if kind == "Knife" and (t.Name == "Knife" or t:FindFirstChild("Events")) then return true end
        end
    end
    return false
end

local CACHE_TTL = 0.05
local roleCache, aliveCache, cacheStamp = {}, {}, 0

local function sweepCaches()
    local now = os.clock()
    if now - cacheStamp > CACHE_TTL then
        table.clear(roleCache); table.clear(aliveCache); cacheStamp = now
        KM.refreshTags()
    end
    if now - (KM.rosterAt or 0) > 2 then
        KM.rosterAt = now; KM.refreshPlrs()
    end
end

local function computeRole(plr)
    local d = roundData(plr); local r = d and d.Role
    if r == "Murderer" then return "Murderer" end
    if r == "Sheriff" or r == "Hero" then return r end
    local ch = plr.Character
    if playerHasTag(plr,"Weapon_Gun")   or (ch and charHasWeapon(ch,"Gun"))   then return "Hero" end
    if playerHasTag(plr,"Weapon_Knife") or (ch and charHasWeapon(ch,"Knife")) then return "Murderer" end
    return r or "Innocent"
end

local function computeAlive(plr)
    local d = roundData(plr); if d and d.Dead == true then return false end
    local ch = plr.Character; local hum = ch and getHum(ch)
    return ch and hum and hum.Health > 0 and getHRP(ch)
end

local function roleOf(plr)
    sweepCaches()
    local v = roleCache[plr]
    if v == nil then v = computeRole(plr); roleCache[plr] = v end
    return v
end

local function alive(plr)
    sweepCaches()
    local v = aliveCache[plr]
    if v == nil then v = computeAlive(plr) or false; aliveCache[plr] = v end
    return v
end

local function isGunRole(role) return role == "Sheriff" or role == "Hero" end
local function myRole()        return roleOf(LocalPlayer) end
local function findMurderer()
    for _, p in ipairs(KM.plrs) do if roleOf(p) == "Murderer" then return p end end
end

function KM.hasBody(plr)
    local ch = plr.Character; if not ch then return nil end
    local hum = getHum(ch); if not (hum and hum.Health > 0) then return nil end
    local hrp = getHRP(ch); if not hrp then return nil end
    return ch, hum, hrp
end

local function roleColor(role)
    if role == "Murderer" then return T.Murder end
    if isGunRole(role)    then return T.Sheriff end
    return T.Innocent
end

local function roleLabel(role)
    if role == "Murderer" then return "[M]" end
    if isGunRole(role)    then return "[S]" end
    return "[I]"
end

function KM.espRole(plr)
    local d = roundData(plr)
    if d and d.Dead == true then return "Innocent" end
    return roleOf(plr)
end

-- ══════════════════════════════════════════════════════════
--  CANACT
-- ══════════════════════════════════════════════════════════
function KM.canAct()
    if KM.teleporting() then return false end
    local ch = myChar(); if not ch or not ch.Parent then return false end
    local hum = getHum(ch); if not (hum and hum.Health > 0) then return false end
    if not getHRP(ch) then return false end
    if LocalPlayer:GetAttribute("Alive") == false then return false end
    local d = roundData(LocalPlayer)
    if d and d.Dead == true then return false end
    return true
end

-- ══════════════════════════════════════════════════════════
--  GUI FACTORY
-- ══════════════════════════════════════════════════════════
local function New(cls, props, parent)
    local o = Instance.new(cls)
    if parent then o.Parent = parent end
    for k, v in pairs(props or {}) do pcall(function() o[k] = v end) end
    return o
end
local function Corner(r, p) return New("UICorner", {CornerRadius = UDim.new(0, r or 8)}, p) end
local function Stroke(col, th, p)
    return New("UIStroke", {
        Color = col, Thickness = th or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, p)
end
local function List(sp, p)
    return New("UIListLayout", {SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, sp or 4)}, p)
end
local function Pad(l, r, t, b, p)
    return New("UIPadding", {
        PaddingLeft = UDim.new(0,l), PaddingRight = UDim.new(0,r),
        PaddingTop  = UDim.new(0,t), PaddingBottom = UDim.new(0,b),
    }, p)
end
local function AutoCanvas(scroll, layout)
    layout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        scroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 12)
    end)
end
local function Safe(fn, ...) local ok, err = pcall(fn, ...); if not ok then warn("[KuraiMoka] " .. tostring(err)) end return ok end

-- ══════════════════════════════════════════════════════════
--  DRAWING / ESP
-- ══════════════════════════════════════════════════════════
local hasDrawing = typeof(Drawing) == "table" and pcall(function()
    local p = Drawing.new("Line"); p:Remove()
end)

local drawn = {}
local function trackDraw(o) drawn[o] = true; return o end
local function dropDraw(o)
    if o == nil then return end
    drawn[o] = nil
    pcall(function() o:Remove() end)
end
local function clearDrawn()
    for o in pairs(drawn) do pcall(function() o:Remove() end) end
    table.clear(drawn)
end

local EspGui = New("ScreenGui", {
    Name = "KuraiMoka_ESP",
    ResetOnSpawn = false,
    IgnoreGuiInset = false,
    DisplayOrder = 998,
}, Mount)
protect(EspGui)

-- Line wrapper
local lineMT = {}
local function applyLine(t)
    local f = rawget(t, "_f"); if not (f and f.Parent) then return end
    local a, b = rawget(t,"_From"), rawget(t,"_To"); if not (a and b) then return end
    local d = b - a
    f.Position = UDim2.fromOffset((a.X+b.X)*0.5, (a.Y+b.Y)*0.5)
    f.Size     = UDim2.fromOffset(math.max(d.Magnitude,1), math.max(rawget(t,"_Thickness") or 1, 1))
    f.Rotation = math.deg(math.atan2(d.Y, d.X))
end
lineMT.__index = function(t, k)
    if k == "Remove" then return function(self)
        local f = rawget(self,"_f"); if f then pcall(function() f:Destroy() end) end
    end end
    return rawget(t, "_"..k)
end
lineMT.__newindex = function(t, k, v)
    rawset(t, "_"..k, v)
    local f = rawget(t,"_f"); if not (f and f.Parent) then return end
    if k=="Visible" then f.Visible = v==true
    elseif k=="Color" then f.BackgroundColor3 = v
    elseif k=="Transparency" then f.BackgroundTransparency = 1-(tonumber(v) or 1)
    elseif k=="From" or k=="To" or k=="Thickness" then applyLine(t) end
end

local function newLine(thickness)
    if hasDrawing then
        local l = Drawing.new("Line"); l.Thickness = thickness; l.Transparency = 1; l.Visible = false
        return trackDraw(l)
    end
    local t = setmetatable({}, lineMT)
    rawset(t, "_f", New("Frame", {
        AnchorPoint = Vector2.new(0.5,0.5), BorderSizePixel = 0,
        BackgroundColor3 = Color3.new(1,1,1), Visible = false, ZIndex = 3,
    }, EspGui))
    rawset(t, "_Thickness", thickness); rawset(t, "_Visible", false)
    return t
end

-- FOV Circle
local FovCircle = New("Frame", {
    AnchorPoint = Vector2.new(0.5,0.5), Position = UDim2.fromScale(0.5,0.5),
    Size = UDim2.fromOffset(240,240), BackgroundTransparency = 1, BorderSizePixel = 0, Visible = false,
}, EspGui)
Corner(999, FovCircle)
New("UIStroke", {Color = T.Accent, Thickness = 1.5, Transparency = 0.25}, FovCircle)

