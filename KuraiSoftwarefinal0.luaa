-- ══════════════════════════════════════════════
--  CLEANUP MANAGER — aucune fuite de connexion
-- ══════════════════════════════════════════════
local Janitor = {}
Janitor._items = {}

function Janitor:Add(item, method)
    table.insert(self._items, {item = item, method = method or "Disconnect"})
    return item
end

function Janitor:AddTask(fn)
    table.insert(self._items, {item = fn, method = "__call"})
    return fn
end

function Janitor:Clean()
    for _, entry in ipairs(self._items) do
        local ok, err = pcall(function()
            if entry.method == "__call" then
                entry.item()
            elseif entry.method == "Disconnect" then
                if entry.item and entry.item.Disconnect then
                    entry.item:Disconnect()
                end
            elseif entry.method == "Destroy" then
                if entry.item and entry.item.Destroy then
                    entry.item:Destroy()
                end
            elseif entry.method == "Remove" then
                if entry.item and entry.item.Remove then
                    entry.item:Remove()
                end
            end
        end)
        if not ok then Log.Warn("Janitor clean error: " .. tostring(err)) end
    end
    self._items = {}
end

function Janitor:New()
    return setmetatable({_items = {}}, {__index = Janitor})
end

local MainJanitor    = Janitor:New()
local CharJanitor    = Janitor:New()
local VisualJanitor  = Janitor:New()

-- ══════════════════════════════════════════════
--  LOCAL PLAYER
-- ══════════════════════════════════════════════
local LP   = Players.LocalPlayer
local Cam  = WS.CurrentCamera
local Mouse = LP:GetMouse()
local PGui  = LP:WaitForChild("PlayerGui")

local function GetChar()  return LP.Character end
local function GetHum()
    local c = GetChar()
    return c and c:FindFirstChildOfClass("Humanoid")
end
local function GetRoot()
    local c = GetChar()
    return c and c:FindFirstChild("HumanoidRootPart")
end
local function GetDist(a, b) return (a - b).Magnitude end

-- ══════════════════════════════════════════════
--  ROLES MODULE
-- ══════════════════════════════════════════════
local RoleModule = {}
RoleModule._cache = {Murder = nil, Sheriff = nil}
RoleModule._dirty = true

function RoleModule:Invalidate()
    self._dirty = true
end

function RoleModule:Update()
    if not self._dirty then return end
    self._dirty = false
    self._cache.Murder  = nil
    self._cache.Sheriff = nil

    for _, p in ipairs(Players:GetPlayers()) do
        local char = p.Character
        if not char then continue end
        for _, v in ipairs(char:GetChildren()) do
            if v:IsA("Tool") then
                local n = v.Name:lower()
                if n:find("knife") then
                    self._cache.Murder = p
                elseif n:find("gun") then
                    self._cache.Sheriff = p
                end
            end
        end
    end

    -- RemoteEvent fallback
    pcall(function()
        for _, p in ipairs(Players:GetPlayers()) do
            if p:FindFirstChild("IsMurderer") or p:FindFirstChild("Murderer") then
                self._cache.Murder = p
            end
            if p:FindFirstChild("IsSheriff") or p:FindFirstChild("Sheriff") then
                self._cache.Sheriff = p
            end
        end
    end)
end

function RoleModule:GetMurder()  self:Update(); return self._cache.Murder end
function RoleModule:GetSheriff() self:Update(); return self._cache.Sheriff end

function RoleModule:GetRole(p)
    self:Update()
    if self._cache.Murder  == p then return "Murder"  end
    if self._cache.Sheriff == p then return "Sheriff" end
    return "Innocent"
end

function RoleModule:GetColor(p)
    local T = CFG.Theme
    local role = self:GetRole(p)
    if role == "Murder"  then return T.Murder  end
    if role == "Sheriff" then return T.Sheriff end
    return T.Innocent
end

function RoleModule:GetLabel(p)
    local role = self:GetRole(p)
    if role == "Murder"  then return "[MURDER]"  end
    if role == "Sheriff" then return "[SHERIFF]" end
    return "[INNOCENT]"
end

-- Invalidate on tool changes
MainJanitor:Add(Players.PlayerAdded:Connect(function(p)
    p.CharacterAdded:Connect(function(char)
        char.ChildAdded:Connect(function(c)
            if c:IsA("Tool") then RoleModule:Invalidate() end
        end)
        char.ChildRemoved:Connect(function(c)
            if c:IsA("Tool") then RoleModule:Invalidate() end
        end)
    end)
end))

-- ══════════════════════════════════════════════
--  UTILITY
-- ══════════════════════════════════════════════
local function W2V(pos)
    local sp, on = Cam:WorldToViewportPoint(pos)
    return Vector2.new(sp.X, sp.Y), on, sp.Z
end

local function SafePcall(fn, ...)
    local ok, err = pcall(fn, ...)
    if not ok then Log.Warn(tostring(err)) end
    return ok
end

local function GetNearestInFOV(fov)
    local nearest, nearDist = nil, math.huge
    local root = GetRoot()
    if not root then return nil end
    local center = Vector2.new(Cam.ViewportSize.X / 2, Cam.ViewportSize.Y / 2)
    for _, p in ipairs(Players:GetPlayers()) do
        if p == LP then continue end
        local char = p.Character
        if not char then continue end
        local hr = char:FindFirstChild("HumanoidRootPart")
        if not hr then continue end
        local sp, onSc = Cam:WorldToViewportPoint(hr.Position)
        if not onSc then continue end
        local screenPos = Vector2.new(sp.X, sp.Y)
        local d2 = (screenPos - center).Magnitude
        if fov and d2 > fov then continue end
        local dist = GetDist(root.Position, hr.Position)
        if dist < nearDist then
            nearest  = p
            nearDist = dist
        end
    end
    return nearest
end

-- ══════════════════════════════════════════════
--  NOTIFICATION SYSTEM (custom, non-StarterGui)
-- ══════════════════════════════════════════════
local NotifModule = {}
NotifModule._queue = {}
NotifModule._active = false
NotifModule._container = nil

function NotifModule:_Init(parent)
    self._container = Instance.new("Frame")
    self._container.Name = "NotifContainer"
    self._container.BackgroundTransparency = 1
    self._container.Position = UDim2.new(1, -320, 1, -20)
    self._container.Size = UDim2.new(0, 300, 0, 0)
    self._container.AnchorPoint = Vector2.new(0, 1)
    self._container.Parent = parent
    local layout = Instance.new("UIListLayout")
    layout.SortOrder = Enum.SortOrder.LayoutOrder
    layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
    layout.Padding = UDim.new(0, 6)
    layout.Parent = self._container
end

function NotifModule:Push(title, msg, dur, color)
    dur   = dur   or 4
    color = color or CFG.Theme.Accent

    local T = CFG.Theme
    local card = Instance.new("Frame")
    card.Name = "Notif"
    card.BackgroundColor3 = T.BgPanel
    card.BorderSizePixel  = 0
    card.Size = UDim2.new(1, 0, 0, 56)
    card.BackgroundTransparency = 1
    card.Parent = self._container
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = card
    -- Accent bar
    local bar = Instance.new("Frame")
    bar.BackgroundColor3 = color
    bar.BorderSizePixel  = 0
    bar.Position = UDim2.new(0, 0, 0, 0)
    bar.Size     = UDim2.new(0, 3, 1, 0)
    bar.Parent   = card
    local bc2 = Instance.new("UICorner")
    bc2.CornerRadius = UDim.new(0, 3)
    bc2.Parent = bar
    -- Title
    local tl = Instance.new("TextLabel")
    tl.BackgroundTransparency = 1
    tl.Position = UDim2.new(0, 12, 0, 8)
    tl.Size     = UDim2.new(1, -16, 0, 18)
    tl.Font     = Enum.Font.GothamBold
    tl.Text     = tostring(title)
    tl.TextColor3 = T.White
    tl.TextSize   = 13
    tl.TextXAlignment = Enum.TextXAlignment.Left
    tl.Parent = card
    -- Message
    local ml = Instance.new("TextLabel")
    ml.BackgroundTransparency = 1
    ml.Position = UDim2.new(0, 12, 0, 28)
    ml.Size     = UDim2.new(1, -16, 0, 18)
    ml.Font     = Enum.Font.Gotham
    ml.Text     = tostring(msg)
    ml.TextColor3 = T.Gray
    ml.TextSize   = 11
    ml.TextXAlignment = Enum.TextXAlignment.Left
    ml.Parent = card

    -- Animate in
    TweenService:Create(card, TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        BackgroundTransparency = 0,
        Size = UDim2.new(1, 0, 0, 56),
    }):Play()

    -- Progress bar
    local progress = Instance.new("Frame")
    progress.BackgroundColor3 = color
    progress.BackgroundTransparency = 0.5
    progress.BorderSizePixel = 0
    progress.Position = UDim2.new(0, 3, 1, -3)
    progress.Size     = UDim2.new(1, -6, 0, 2)
    progress.Parent   = card
    local pc3 = Instance.new("UICorner")
    pc3.CornerRadius = UDim.new(0, 2)
    pc3.Parent = progress

    TweenService:Create(progress, TweenInfo.new(dur, Enum.EasingStyle.Linear), {
        Size = UDim2.new(0, 0, 0, 2),
    }):Play()

    -- Auto remove
    task.delay(dur, function()
        TweenService:Create(card, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            BackgroundTransparency = 1,
            Position = UDim2.new(1, 10, 0, 0),
        }):Play()
        task.delay(0.22, function()
            if card and card.Parent then card:Destroy() end
        end)
    end)
end

-- Fallback also set StarterGui
local function Notify(title, msg, dur, color)
    NotifModule:Push(title, msg, dur, color)
    pcall(function()
        StarterGui:SetCore("SendNotification", {
            Title    = CFG.Name .. " | " .. tostring(title),
            Text     = tostring(msg),
            Duration = dur or 4,
        })
    end)
end

-- ══════════════════════════════════════════════
--  GUI FACTORY
-- ══════════════════════════════════════════════
local UI = {}

function UI.New(cls, props, parent)
    local i = Instance.new(cls)
    if parent then i.Parent = parent end
    for k, v in pairs(props or {}) do
        local ok = pcall(function() i[k] = v end)
    end
    return i
end

function UI.Corner(r, parent)
    return UI.New("UICorner", {CornerRadius = UDim.new(0, r or 8)}, parent)
end

function UI.Stroke(color, thickness, parent)
    return UI.New("UIStroke", {
        Color     = color or CFG.Theme.Sep,
        Thickness = thickness or 1,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
    }, parent)
end

function UI.Pad(l, r, t, b, parent)
    return UI.New("UIPadding", {
        PaddingLeft   = UDim.new(0, l or 0),
        PaddingRight  = UDim.new(0, r or 0),
        PaddingTop    = UDim.new(0, t or 0),
        PaddingBottom = UDim.new(0, b or 0),
    }, parent)
end

function UI.List(spacing, parent, dir)
    return UI.New("UIListLayout", {
        SortOrder          = Enum.SortOrder.LayoutOrder,
        Padding            = UDim.new(0, spacing or 4),
        FillDirection      = dir or Enum.FillDirection.Vertical,
    }, parent)
end

local TI_FAST   = TweenInfo.new(0.16, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local TI_MED    = TweenInfo.new(0.25, Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
local TI_SPRING = TweenInfo.new(0.35, Enum.EasingStyle.Back,  Enum.EasingDirection.Out)

function UI.Tween(obj, props, info)
    TweenService:Create(obj, info or TI_FAST, props):Play()
end

