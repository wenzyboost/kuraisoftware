    MkToggle(p,"Auto Ramasser le Gun","Ramasse le gun dès qu'il apparaît",false,function(v) flags.autoGun=v end)
    MkToggle(p,"Gun ESP","Surligne le gun au sol",false,function(v) flags.gunEsp=v end)
    MkButton(p,"Ramasser Gun Maintenant",nil,false,function()
        local h=getHRP(myChar())
        if not h then Notify("Erreur","Pas de personnage","error"); return end
        -- cherche le gun dans le workspace
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.Name=="GunDrop" and d:IsA("BasePart") then
