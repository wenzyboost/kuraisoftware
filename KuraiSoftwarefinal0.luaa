local function Section(title, parent)
    local f = UI.New("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 28),
    }, parent)
    UI.New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 2, 0, 8),
        Size     = UDim2.new(0, 200, 0, 14),
        Font     = Enum.Font.GothamBold,
        Text     = title:upper(),
        TextColor3 = T.Accent,
        TextSize   = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, f)
    UI.New("Frame", {
        BackgroundColor3 = T.Sep,
        BorderSizePixel  = 0,
        Position = UDim2.new(0, 0, 1, -1),
        Size     = UDim2.new(1, 0, 0, 1),
    }, f)
    return f
end

local function Spacer(h, parent)
    UI.New("Frame", {BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, h or 6)}, parent)
end

-- TOGGLE
local function Toggle(parent, title, sub, initVal, cb)
    local rowH = sub and 52 or 44
    local row = UI.New("Frame", {
        BackgroundColor3 = T.BgItem,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, 0, 0, rowH),
    }, parent)
    UI.Corner(9, row)
    UI.New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, sub and 6 or 0),
        Size     = UDim2.new(1, -80, 0, 22),
        Font     = Enum.Font.Gotham,
        Text     = title,
        TextColor3 = T.White,
        TextSize   = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    if sub then
        UI.New("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0, 12, 0, 28),
            Size     = UDim2.new(1, -80, 0, 16),
            Font     = Enum.Font.Gotham,
            Text     = sub,
            TextColor3 = T.Muted,
            TextSize   = 10,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, row)
    end
    local track = UI.New("Frame", {
        BackgroundColor3 = initVal and T.TogOn or T.TogOff,
        BorderSizePixel  = 0,
        Position = UDim2.new(1, -58, 0.5, -11),
        Size     = UDim2.new(0, 44, 0, 22),
    }, row)
    UI.Corner(99, track)
    local thumb = UI.New("Frame", {
        BackgroundColor3 = T.White,
        BorderSizePixel  = 0,
        Position = initVal and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9),
        Size     = UDim2.new(0, 18, 0, 18),
    }, track)
    UI.Corner(99, thumb)

    local val = initVal
    local btn = UI.New("TextButton", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Text = "",
        ZIndex = 5,
    }, row)

    local function SetVisual(v)
        UI.Tween(track, {BackgroundColor3 = v and T.TogOn or T.TogOff})
        UI.Tween(thumb, {Position = v and UDim2.new(1, -20, 0.5, -9) or UDim2.new(0, 2, 0.5, -9)})
    end

    btn.MouseButton1Click:Connect(function()
        val = not val
        SetVisual(val)
        if cb then SafePcall(cb, val) end
    end)
    btn.MouseEnter:Connect(function() UI.Tween(row, {BackgroundColor3 = T.BgHover}) end)
    btn.MouseLeave:Connect(function() UI.Tween(row, {BackgroundColor3 = T.BgItem})  end)

    local function Set(v)
        val = v
        SetVisual(val)
    end
    return row, Set
end

-- SLIDER
local function Slider(parent, title, min, max, def, cb, suffix)
    suffix = suffix or ""
    local row = UI.New("Frame", {
        BackgroundColor3 = T.BgItem,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, 0, 0, 64),
    }, parent)
    UI.Corner(9, row)
    UI.New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 8),
        Size     = UDim2.new(1, -80, 0, 20),
        Font     = Enum.Font.Gotham,
        Text     = title,
        TextColor3 = T.White,
        TextSize   = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local valBox = UI.New("Frame", {
        BackgroundColor3 = T.Bg,
        BorderSizePixel  = 0,
        Position = UDim2.new(1, -60, 0, 8),
        Size     = UDim2.new(0, 48, 0, 20),
    }, row)
    UI.Corner(6, valBox)
    local valLabel = UI.New("TextLabel", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        Font     = Enum.Font.GothamBold,
        Text     = tostring(def) .. suffix,
        TextColor3 = T.Accent,
        TextSize   = 12,
    }, valBox)
    local track = UI.New("Frame", {
        BackgroundColor3 = Color3.fromRGB(36, 36, 50),
        BorderSizePixel  = 0,
        Position = UDim2.new(0, 12, 0, 42),
        Size     = UDim2.new(1, -24, 0, 6),
    }, row)
    UI.Corner(99, track)
    local pct = math.clamp((def - min) / (max - min), 0, 1)
    local fill = UI.New("Frame", {
        BackgroundColor3 = T.Accent,
        BorderSizePixel  = 0,
        Size             = UDim2.new(pct, 0, 1, 0),
    }, track)
    UI.Corner(99, fill)
    local knob = UI.New("Frame", {
        BackgroundColor3 = T.White,
        BorderSizePixel  = 0,
        Position = UDim2.new(pct, -8, 0.5, -8),
        Size     = UDim2.new(0, 16, 0, 16),
    }, track)
    UI.Corner(99, knob)

    local dragging = false
    local cur = def
    local function UpdateAt(x)
        local ap = track.AbsolutePosition.X
        local as = track.AbsoluteSize.X
        local r  = math.clamp((x - ap) / as, 0, 1)
        cur = math.floor(min + (max - min) * r)
        fill.Size     = UDim2.new(r, 0, 1, 0)
        knob.Position = UDim2.new(r, -8, 0.5, -8)
        valLabel.Text = tostring(cur) .. suffix
        if cb then SafePcall(cb, cur) end
    end

    track.InputBegan:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or
           i.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            UpdateAt(i.Position.X)
        end
    end)
    MainJanitor:Add(UIS.InputChanged:Connect(function(i)
        if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or
                          i.UserInputType == Enum.UserInputType.Touch) then
            UpdateAt(i.Position.X)
        end
    end))
    MainJanitor:Add(UIS.InputEnded:Connect(function(i)
        if i.UserInputType == Enum.UserInputType.MouseButton1 or
           i.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end))
    return row
end

-- BUTTON
local function Button(parent, title, icon, cb)
    local row = UI.New("Frame", {
        BackgroundColor3 = T.BgItem,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, 0, 0, 44),
    }, parent)
    UI.Corner(9, row)
    UI.New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size     = UDim2.new(1, -50, 1, 0),
        Font     = Enum.Font.Gotham,
        Text     = title,
        TextColor3 = T.White,
        TextSize   = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    if icon and icon ~= "" then
        UI.New("TextLabel", {
            BackgroundTransparency = 1,
            Position = UDim2.new(1, -36, 0, 0),
            Size     = UDim2.new(0, 24, 1, 0),
            Font     = Enum.Font.GothamBold,
            Text     = icon,
            TextColor3 = T.Accent,
            TextSize   = 18,
        }, row)
    end
    local btn = UI.New("TextButton", {
        BackgroundTransparency = 1,
        Size   = UDim2.new(1, 0, 1, 0),
        Text   = "",
        ZIndex = 5,
    }, row)
    btn.MouseEnter:Connect(function() UI.Tween(row, {BackgroundColor3 = T.BgHover}) end)
    btn.MouseLeave:Connect(function() UI.Tween(row, {BackgroundColor3 = T.BgItem})  end)
    btn.MouseButton1Click:Connect(function()
        UI.Tween(row, {BackgroundColor3 = T.AccentDim})
        task.delay(0.15, function() UI.Tween(row, {BackgroundColor3 = T.BgItem}) end)
        if cb then SafePcall(cb) end
    end)
    return row
end

-- PICKER (dropdown)
local function Picker(parent, title, opts, def, cb)
    local selected = def or opts[1]
    local open     = false
    local container = UI.New("Frame", {
        BackgroundTransparency = 1,
        BorderSizePixel        = 0,
        Size                   = UDim2.new(1, 0, 0, 44),
        ClipsDescendants       = false,
        ZIndex                 = 5,
    }, parent)
    local row = UI.New("Frame", {
        BackgroundColor3 = T.BgItem,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, 0, 0, 44),
        ZIndex           = 5,
    }, container)
    UI.Corner(9, row)
    UI.New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size     = UDim2.new(0.55, 0, 1, 0),
        Font     = Enum.Font.Gotham,
        Text     = title,
        TextColor3 = T.White,
        TextSize   = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 5,
    }, row)
    local selLabel = UI.New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0.55, 0, 0, 0),
        Size     = UDim2.new(0.45, -36, 1, 0),
        Font     = Enum.Font.Gotham,
        Text     = selected,
        TextColor3 = T.Muted,
        TextSize   = 12,
        TextXAlignment = Enum.TextXAlignment.Right,
        ZIndex = 5,
    }, row)
    UI.New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -32, 0, 0),
        Size     = UDim2.new(0, 20, 1, 0),
        Font     = Enum.Font.GothamBold,
        Text     = "⌄",
        TextColor3 = T.Accent,
        TextSize   = 18,
        ZIndex = 5,
    }, row)

    local dropH = #opts * 30 + 8
    local drop = UI.New("Frame", {
        BackgroundColor3 = T.BgPanel,
        BorderSizePixel  = 0,
        Position         = UDim2.new(0, 0, 0, 46),
        Size             = UDim2.new(1, 0, 0, dropH),
        Visible          = false,
        ZIndex           = 22,
    }, container)
    UI.Corner(9, drop)
    UI.Stroke(T.Sep, 1, drop)
    UI.List(2, drop)
    UI.Pad(4, 4, 4, 4, drop)

    for _, opt in ipairs(opts) do
        local ob = UI.New("TextButton", {
            BackgroundColor3 = opt == selected and T.AccentDim or Color3.fromRGB(28, 28, 40),
            BorderSizePixel  = 0,
            Size             = UDim2.new(1, 0, 0, 26),
            Font             = Enum.Font.Gotham,
            Text             = opt,
            TextColor3       = opt == selected and T.AccentGlow or T.White,
            TextSize         = 12,
            ZIndex           = 23,
        }, drop)
        UI.Corner(6, ob)
        ob.MouseButton1Click:Connect(function()
            selected      = opt
            selLabel.Text = opt
            drop.Visible  = false
            open          = false
            container.Size = UDim2.new(1, 0, 0, 44)
            if cb then SafePcall(cb, opt) end
        end)
    end

    local hbtn = UI.New("TextButton", {
        BackgroundTransparency = 1,
        Size   = UDim2.new(1, 0, 1, 0),
        Text   = "",
        ZIndex = 6,
    }, row)
    hbtn.MouseButton1Click:Connect(function()
        open         = not open
        drop.Visible = open
        container.Size = open and UDim2.new(1, 0, 0, 44 + dropH + 6) or UDim2.new(1, 0, 0, 44)
    end)
    return container
end

-- INPUT
local function Input(parent, title, placeholder, cb)
    local row = UI.New("Frame", {
        BackgroundColor3 = T.BgItem,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, 0, 0, 58),
    }, parent)
    UI.Corner(9, row)
    UI.New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 6),
        Size     = UDim2.new(1, -24, 0, 16),
        Font     = Enum.Font.Gotham,
        Text     = title,
        TextColor3 = T.Gray,
        TextSize   = 10,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, row)
    local box = UI.New("TextBox", {
        BackgroundColor3  = T.Bg,
        BorderSizePixel   = 0,
        Position          = UDim2.new(0, 12, 0, 26),
        Size              = UDim2.new(1, -24, 0, 24),
        Font              = Enum.Font.Gotham,
        PlaceholderText   = placeholder or "",
        PlaceholderColor3 = T.Muted,
        Text              = "",
        TextColor3        = T.White,
        TextSize          = 12,
        ClearTextOnFocus  = false,
    }, row)
    UI.Corner(6, box)
    box.FocusLost:Connect(function()
        if cb then SafePcall(cb, box.Text) end
    end)
    return row, box
end

-- ══════════════════════════════════════════════
--  TAB SYSTEM
-- ══════════════════════════════════════════════
local Pages   = {}
local TabBtns = {}

local TABS = {
    {n = "Main",      ic = "⚡"},
    {n = "Combat",    ic = "⚔"},
    {n = "Target",    ic = "🎯"},
    {n = "CamLock",   ic = "🔒"},
    {n = "ESP",       ic = "👁"},
    {n = "Crosshair", ic = "✛"},
    {n = "Roles",     ic = "🎭"},
    {n = "Player",    ic = "🏃"},
    {n = "Misc",      ic = "🔧"},
    {n = "Graphics",  ic = "🖥"},
    {n = "Skybox",    ic = "🌌"},
    {n = "Webhook",   ic = "📡"},
    {n = "Settings",  ic = "⚙"},
}

local function SwitchTab(name)
    State.ActiveTab   = name
    ContentTitle.Text = name
    for n, pg in pairs(Pages) do
        pg.Visible = (n == name)
    end
    for n, btn in pairs(TabBtns) do
        local active = (n == name)
        local ind = btn:FindFirstChild("Indicator")
        if ind then ind.Visible = active end
        local lbl = btn:FindFirstChildOfClass("TextLabel")
        if lbl then
            lbl.TextColor3 = active and T.White or T.Gray
            lbl.Font       = active and Enum.Font.GothamBold or Enum.Font.Gotham
        end
        UI.Tween(btn, {BackgroundColor3 = active and Color3.fromRGB(28, 28, 42) or Color3.new(0, 0, 0)})
        btn.BackgroundTransparency = active and 0 or 1
    end
end

for i, tab in ipairs(TABS) do
    local btn = UI.New("TextButton", {
        Name             = "TabBtn_" .. tab.n,
        BackgroundColor3 = Color3.fromRGB(28, 28, 42),
        BackgroundTransparency = tab.n == "Main" and 0 or 1,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, 0, 0, 34),
        Text             = "",
        LayoutOrder      = i,
    }, TabScroll)
    UI.Corner(8, btn)

    UI.New("Frame", {
        Name             = "Indicator",
        BackgroundColor3 = T.Accent,
        BorderSizePixel  = 0,
        Position         = UDim2.new(0, 0, 0.15, 0),
        Size             = UDim2.new(0, 3, 0.7, 0),
        Visible          = tab.n == "Main",
    }, btn)
    UI.Corner(99, btn:FindFirstChild("Indicator"))

    UI.New("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0),
        Size     = UDim2.new(1, -12, 1, 0),
        Font     = tab.n == "Main" and Enum.Font.GothamBold or Enum.Font.Gotham,
        Text     = tab.ic .. "  " .. tab.n,
        TextColor3 = tab.n == "Main" and T.White or T.Gray,
        TextSize   = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
    }, btn)

    TabBtns[tab.n] = btn

    local page = UI.New("Frame", {
        Name             = "Page_" .. tab.n,
        BackgroundTransparency = 1,
        BorderSizePixel  = 0,
        Size             = UDim2.new(1, 0, 0, 0),
        Visible          = tab.n == "Main",
    }, ContentScroll)
    local pl = UI.List(4, page)
    pl:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        page.Size = UDim2.new(1, 0, 0, pl.AbsoluteContentSize.Y)
    end)
    Pages[tab.n] = page

    btn.MouseButton1Click:Connect(function() SwitchTab(tab.n) end)
end

-- ══════════════════════════════════════════════
--  DRAWING SYSTEM
-- ══════════════════════════════════════════════
local DrawStore = {}

local function NewDraw(type, props)
    local d = Drawing.new(type)
    for k, v in pairs(props or {}) do
        pcall(function() d[k] = v end)
    end
    table.insert(DrawStore, d)
    return d
end

local function CleanDraws()
    for _, d in ipairs(DrawStore) do
        pcall(function() d:Remove() end)
    end
    DrawStore = {}
end

-- FOV circle
local FovCircle = NewDraw("Circle", {
    Visible      = false,
    Thickness    = 1.5,
    Color        = T.White,
    Filled       = false,
    Transparency = 0.45,
    NumSides     = 64,
})

-- Crosshair
local CH = {
    Dot    = NewDraw("Circle", {Visible = false, Filled = true,  Thickness = 1,   NumSides = 32}),
    Top    = NewDraw("Line",   {Visible = false, Thickness = 1.5}),
    Bottom = NewDraw("Line",   {Visible = false, Thickness = 1.5}),
    Left   = NewDraw("Line",   {Visible = false, Thickness = 1.5}),
    Right  = NewDraw("Line",   {Visible = false, Thickness = 1.5}),
    Circle = NewDraw("Circle", {Visible = false, Filled = false, Thickness = 1.5, NumSides = 40}),
}

-- ══════════════════════════════════════════════
--  ESP SYSTEM — per-player drawing objects
-- ══════════════════════════════════════════════
local ESPStore = {}

local function ESPClear(p)
    if ESPStore[p] then
        for _, d in pairs(ESPStore[p]) do
            pcall(function() d:Remove() end)
        end
        ESPStore[p] = nil
    end
end

local function ESPMake(p)
    ESPClear(p)
    ESPStore[p] = {
        TL     = NewDraw("Line",   {Visible = false, Thickness = 2}),
        TR     = NewDraw("Line",   {Visible = false, Thickness = 2}),
        BL     = NewDraw("Line",   {Visible = false, Thickness = 2}),
        BR     = NewDraw("Line",   {Visible = false, Thickness = 2}),
        LT     = NewDraw("Line",   {Visible = false, Thickness = 2}),
        RT     = NewDraw("Line",   {Visible = false, Thickness = 2}),
        LB     = NewDraw("Line",   {Visible = false, Thickness = 2}),
        RB     = NewDraw("Line",   {Visible = false, Thickness = 2}),
        Name   = NewDraw("Text",   {Visible = false, Size = 14, Center = true, Outline = true, Font = Drawing.Fonts.Plex}),
        Role   = NewDraw("Text",   {Visible = false, Size = 11, Center = true, Outline = true, Font = Drawing.Fonts.Plex}),
        Dist   = NewDraw("Text",   {Visible = false, Size = 11, Center = true, Outline = true, Font = Drawing.Fonts.Plex}),
        HpBg   = NewDraw("Square", {Visible = false, Filled = true, Color = Color3.fromRGB(0, 0, 0), Transparency = 0.3}),
        HpFill = NewDraw("Square", {Visible = false, Filled = true}),
        Tracer = NewDraw("Line",   {Visible = false, Thickness = 1, Transparency = 0.6}),
    }
end

local function ESPHide(esp)
    for _, d in pairs(esp) do
        d.Visible = false
    end
end

-- Init existing players
for _, p in ipairs(Players:GetPlayers()) do
    if p ~= LP then ESPMake(p) end
end

MainJanitor:Add(Players.PlayerAdded:Connect(function(p)
    task.wait(0.5)
    if p ~= LP then ESPMake(p) end
end))

MainJanitor:Add(Players.PlayerRemoving:Connect(function(p)
    ESPClear(p)
end))

